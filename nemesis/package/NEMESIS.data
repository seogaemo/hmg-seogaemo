[nemesis]
version=1.1
id=hmg-seogaemo
name=HMG-Seogaemo
type=application,service
package-version=@VERSION@
short-desc="Built-in controls for the Gen5W head unit."
os=*.KOR.*
models=*_kr
postinstall=scripts/postinstall.sh
preuninstall=scripts/preuninstall.sh

[app.0]
kind=sh
path=bin/open.sh
uid=root

[service.0]
name=reconcile
kind=sh
path=svc/reconcile.sh
uid=root
mode=background

[service.1]
name=watcher
kind=sh
path=svc/watcher.sh
uid=root
mode=restart
