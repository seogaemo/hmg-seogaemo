#!/system/bin/sh
umask 077
refuse() {
    echo "state=$2"
    echo restart=none
    echo "detail=$3"
    exit "$1"
}
# Validate before executing any selected payload, and again in that payload.
[ "$#" -ge 2 ] && [ "$#" -le 4 ] || refuse 2 failed 'Invalid command'
case "$1" in
    device) [ "$#:$2" = 2:reboot ] || refuse 2 failed 'Invalid command' ;;
    stock) case "$#:$2" in 2:restore|2:status) ;; *) refuse 2 failed 'Invalid command';; esac ;;
    package) [ "$#:$2" = 2:uninstall ] || refuse 2 failed 'Invalid command' ;;
    export) case "$#:$2:${3:-}" in 2:usb:|2:adb:|3:usb:all|3:usb:ours|3:adb:all|3:adb:ours) ;;
        *) refuse 2 failed 'Invalid command';; esac ;;
    map) case "$#:$2" in 2:status|2:run|2:verify|2:export) ;; *) refuse 2 failed 'Invalid command';; esac ;;
    recorder) case "$#:$2" in 2:status|2:enable|2:disable|2:tick) ;; *) refuse 2 failed 'Invalid command';; esac ;;
    preflight) [ "$#:$2" = 2:run ] || refuse 2 failed 'Invalid command' ;;
    report) [ "$#:$2" = 2:digest ] || refuse 2 failed 'Invalid command' ;;
    foreign) case "$#:$2" in 2:status) ;;
            3:clean) case "$3" in ''|*[!a-z0-9-]*) refuse 2 failed 'Invalid command';; esac ;;
            *) refuse 2 failed 'Invalid command';; esac ;;
    update) case "$#:$2" in 2:stage|2:apply|2:rollback|2:status) ;; *) refuse 2 failed 'Invalid command';; esac ;;
    module)
        case "$#:$2" in
            2:list|2:usb-import|2:install-bundled) ;;
            3:list-removed) case "$3" in [a-z][a-z]) ;; *) refuse 2 failed 'Invalid command';; esac ;;
            3:add-bundled) case "$3" in ''|*[!a-z0-9-]*|-*|*--*|*-) refuse 2 failed 'Invalid command';; esac ;;
            3:install) case "$3" in *[!0-9a-f]*|'') refuse 2 failed 'Invalid command';; esac
                [ "${#3}" -eq 64 ] || refuse 2 failed 'Invalid command' ;;
            3:remove) case "$3" in ''|*[!a-z0-9-]*|-*|*--*|*-) refuse 2 failed 'Invalid command';; esac ;;
            4:describe) case "$3" in ''|*[!a-z0-9-]*|-*|*--*|*-) refuse 2 failed 'Invalid command';; esac
                case "$4" in [a-z][a-z]) ;; *) refuse 2 failed 'Invalid command';; esac ;;
            *) refuse 2 failed 'Invalid command';; esac ;;
    *)
        case "$1" in ''|*[!a-z0-9-]*|-*|*--*|*-) refuse 2 failed 'Invalid command';; esac
        case "$#:$2" in 2:apply|2:revert|2:status|2:precheck|2:tbt-reset) ;;
            3:action) case "$3" in ''|*[!a-z0-9_]*) refuse 2 failed 'Invalid command';; esac
                [ "${#3}" -le 40 ] || refuse 2 failed 'Invalid command' ;;
            3:watch) case "$3" in boot|screen_on) ;; *) refuse 2 failed 'Invalid command';; esac ;;
            4:set) case "$3" in ''|*[!a-z0-9_]*) refuse 2 failed 'Invalid command';; esac
                case "$4" in ''|*[!a-z0-9_.-]*) refuse 2 failed 'Invalid command';; esac ;;
            *) refuse 2 failed 'Invalid command';; esac ;;
esac
base=${0%/*}
base=${base%/bin}
SG_DATA_ROOT=${SG_DATA_ROOT:-/data/nemesis/backup/hmg-seogaemo}
current=$SG_DATA_ROOT/update/current
stable=$base
# OTA archives omit the installed NEMESIS descriptor and lifecycle hooks.
if [ ! -f "$base/NEMESIS.data" ] && [ -L "$current" ] &&
        [ "$(readlink -f "$base")" = "$(readlink -f "$current")" ]; then
    stable=/data/nemesis/apps/hmg-seogaemo
fi
# Recovery must remain reachable without sourcing or executing selected code.
case "$1" in
    update) exec /system/bin/sh "$stable/core/update.sh" "$2";;
    stock|package)
        stock_verb=$2
        [ "$1" != package ] || stock_verb=uninstall
        export SG_DATA_ROOT
        exec /system/bin/sh "$stable/core/stock.sh" "$stock_verb";;
    device|export) base=$stable;;
    *)
        if [ -L "$current" ] && [ "$(readlink -f "$stable")" != "$(readlink -f "$current")" ]; then
            . "$stable/lib/payload.sh"
            if hmg_seogaemo_payload_valid "$current"; then
                if [ "$(readlink -f "$base")" != "$(readlink -f "$current")" ]; then
                    exec /system/bin/sh "$current/bin/hmg-seogaemo-root" "$@"
                fi
            else
                case "$1:$2" in
                    *:status|*:precheck) base=$stable;;
                    *) refuse 1 failed 'Selected OTA payload damaged; roll back or reinstall from USB';;
                esac
            fi
        fi;;
esac
. "$base/lib/common.sh"
if [ "$1" = device ]; then
    [ "$#" -eq 2 ] && [ "$2" = reboot ] || refuse 2 failed 'Invalid command'
    sync || refuse 1 failed 'Could not sync before restart'
    reboot || refuse 1 failed 'Could not restart head unit'
    echo state=pending-restart
    echo restart=head_unit
    echo 'detail=Head unit restart requested'
    exit 0
fi
if [ "$1" = export ]; then
    export_mode=$2
    # Problem report: logs=all|ours adds Android and NEMESIS logs and works before any change exists.
    export_logs=${3:-none}
    case "$2:$export_logs" in usb:none|adb:none|usb:all|usb:ours|adb:all|adb:ours) ;; *) refuse 2 failed 'Invalid command';; esac
    [ -f "$SG_DATA_ROOT/ledger/ledger.tsv" ] || [ "$export_logs" != none ] || {
        echo 'state=failed'; echo 'restart=none'; echo 'detail=No change ledger'; exit 1;
    }
    if [ "$2" = usb ]; then
        export_base=
        for drive in ${SG_USB_DIRS:-/storage/usb0 /storage/usb1 /storage/usb2 /mnt/media_rw/usb0 /mnt/media_rw/usb1 /mnt/media_rw/usb2}; do
            grep -q " $drive " "${SG_MOUNTS_FILE:-/proc/mounts}" 2>/dev/null || continue
            export_base=$drive
            break
        done
        [ -n "$export_base" ] || {
            echo 'state=failed'; echo 'restart=none'; echo 'detail=No mounted USB drive'; exit 1;
        }
    else
        export_base=${SG_EXPORT_ROOT:-/data/local/tmp/hmg-seogaemo-export}
    fi
    size=0
    for record in "$SG_DATA_ROOT"/ledger/ledger.tsv "$SG_DATA_ROOT"/ledger/before/* "$SG_DATA_ROOT"/ledger/after/*; do
        [ -f "$record" ] || continue
        set -- $(ls -ln "$record")
        case "$5" in *[!0-9]*|'') record_size=$4;; *) record_size=$5;; esac
        size=$((size + record_size))
    done
    [ "$size" -le 52428800 ] || {
        echo 'state=failed'; echo 'restart=none'; echo 'detail=Ledger exceeds 50 MB'; exit 1;
    }
    stamp=$(date +%Y%m%d-%H%M%S)
    if [ "$export_mode" = adb ]; then container=$export_base
    else container=$export_base/HMG-Seogaemo-export; fi
    sg_path_safe "$container" || refuse 1 failed 'Could not prepare export'
    dest=$container/$stamp
    sg_path_safe "$dest" || refuse 1 failed 'Could not prepare export'
    mkdir -p "$dest" || refuse 1 failed 'Could not prepare export'
    if [ -d "$SG_DATA_ROOT/ledger" ]; then
        cp -R "$SG_DATA_ROOT/ledger" "$dest/ledger" || refuse 1 failed 'Could not prepare export'
    fi
    mkdir -p "$dest/desired" || refuse 1 failed 'Could not prepare export'
    for record in "$SG_DATA_ROOT"/desired/*; do
        [ -f "$record" ] && cp "$record" "$dest/desired/" || true
    done
    getprop ro.build.product > "$dest/ro.build.product"
    grep '^package-version=' "$base/NEMESIS.data" > "$dest/package-version"
    HMG_SEOGAEMO_BASE=$base HMG_SEOGAEMO_STATE=$SG_DATA_ROOT/core/map
    export HMG_SEOGAEMO_BASE HMG_SEOGAEMO_STATE SG_DATA_ROOT
    hmg_seogaemo_map_active_dir >/dev/null 2>&1 && hmg_seogaemo_map_export "$dest" || true
    . "$base/lib/diagnostics.sh"
    HMG_SEOGAEMO_EXPORT_LOGS=$export_logs
    hmg_seogaemo_diagnostics "$dest" || refuse 1 failed 'Could not collect diagnostics'
    sg_export_public "$dest" && chmod 0755 "$container" || refuse 1 failed 'Could not prepare export'
    keys="package-version ro.build.product"
    [ ! -f "$SG_DATA_ROOT/ledger/ledger.tsv" ] || keys="ledger/ledger.tsv=$SG_DATA_ROOT/ledger/ledger.tsv $keys"
    for record in "$SG_DATA_ROOT"/desired/*; do
        [ -f "$record" ] && [ -f "$dest/desired/${record##*/}" ] && keys="$keys desired/${record##*/}=$record"
    done
    # Intentional word splitting of the key list; names are validated module ids.
    # shellcheck disable=SC2086
    sg_export_seal "$dest" "$export_mode" $keys
    case $? in
        0) ;;
        4) refuse 1 failed 'USB write not flushed' ;;
        *) refuse 1 failed 'Could not prepare export' ;;
    esac
    sg_print "state=on" "restart=none" "info.export_safe=$export_mode" "detail=$dest"
    exit 0
fi
if [ "$1" = map ]; then
    case "$2" in status|run|verify|export) ;; *) refuse 2 failed 'Invalid command';; esac
    export SG_DATA_ROOT
    exec /system/bin/sh "$base/core/hmg-seogaemo-map.sh" "$2"
fi
if [ "$1" = recorder ] || [ "$1" = preflight ] || [ "$1" = report ]; then
    # Read-only reports (fixed verbs, no arguments): see .agents/reports-recorder.md.
    export SG_DATA_ROOT
    exec /system/bin/sh "$base/core/recorder.sh" "$1" "$2"
fi
if [ "$1" = foreign ]; then
    export SG_DATA_ROOT
    exec /system/bin/sh "$base/core/foreign.sh" "$2" ${3:+"$3"}
fi
if [ "$1" = module ]; then
    export SG_DATA_ROOT
    exec /system/bin/sh "$base/core/module.sh" "$2" ${3:+"$3"} ${4:+"$4"}
fi
case "$1" in
    ''|*[!a-z0-9-]*|-*|*--*|*-) refuse 2 failed 'Invalid command' ;;
esac
case "$2:$#" in apply:2|revert:2|status:2|precheck:2|tbt-reset:2|set:4|action:3) ;; watch:3)
    case "$3" in boot|screen_on) ;; *) refuse 2 failed 'Invalid command';; esac ;;
    *) refuse 2 failed 'Invalid command' ;;
esac
[ "$base" != "$0" ] || refuse 2 failed 'Invalid command'
[ -f "$base/modules.list" ] || refuse 2 failed 'Invalid command'
sg_module_known "$base" "$1" || refuse 2 failed 'Invalid command'
script=$(sg_module_script "$base" "$1")
[ -f "$script" ] || refuse 2 failed 'Invalid command'
manifest=$(sg_module_props "$base" "$1")
HMG_SEOGAEMO_BASE=$base
HMG_SEOGAEMO_STATE=$SG_DATA_ROOT/modules/$1
HMG_SEOGAEMO_MODULE_DIR=$(sg_module_dir "$base" "$1")
unset SG_SKIP_CONSENT_FRAMEWORK SG_BOOT_ID_FILE HMG_SEOGAEMO_SERVICE_BIN
export HMG_SEOGAEMO_BASE HMG_SEOGAEMO_STATE HMG_SEOGAEMO_MODULE_DIR SG_DATA_ROOT
if [ "$2" = status ]; then
    status_result=$(/system/bin/sh "$script" status 2>&1)
    status_code=$?
    sg_print "$status_result"
    saved=$(cat "$SG_DATA_ROOT/desired/$1" 2>/dev/null)
    case "$saved" in on|off) ;; *)
        saved=off
        case "$status_result" in *info.desired=off*) ;;
            state=on*|state=pending-restart*) saved=on;; esac ;;
    esac
    sg_print "info.desired=$saved"
    exit "$status_code"
fi
if [ "$2" = precheck ]; then
    exec /system/bin/sh "$script" "$2"
fi
mkdir -p "$SG_DATA_ROOT/desired" "$SG_DATA_ROOT/modules" || refuse 1 failed 'Could not prepare module operation'
chmod 700 "$SG_DATA_ROOT" "$SG_DATA_ROOT/desired" "$SG_DATA_ROOT/modules" || refuse 1 failed 'Could not prepare module operation'
lock=$SG_DATA_ROOT/operation.lock
tries=0
while ! mkdir "$lock" 2>/dev/null; do
    if [ -f "$lock/pid" ]; then
        holder=$(cat "$lock/pid" 2>/dev/null)
        case "$holder" in ''|*[!0-9]*) ;; *)
            if ! kill -0 "$holder" 2>/dev/null; then rm -rf "$lock"; continue; fi ;;
        esac
    fi
    tries=$((tries + 1))
    [ "$tries" -lt 10 ] || { refuse 1 failed 'Module operation busy'; }
    sleep 1
done
sg_write "$$" > "$lock/pid"
trap 'rm -rf "$lock"' EXIT HUP INT TERM
if [ "$2" = tbt-reset ]; then
    # generated diagnostics only (the module's two observation files); not a stock write, no journal or desired state
    [ "$1" = wireless-carplay-and-aa ] || refuse 2 failed 'Invalid command'
    /system/bin/sh "$script" tbt-reset
    exit $?
fi
if [ "${HMG_SEOGAEMO_RECONCILE:-0}" = 1 ]; then
    [ ! -f "$SG_DATA_ROOT/stock/paused" ] || refuse 3 conflict 'Automatic module calls paused'
    automatic_desired=$(cat "$SG_DATA_ROOT/desired/$1" 2>/dev/null)
    automatic_apk=0
    case "$(pm path com.seogaemo.hmg 2>/dev/null)" in package:*) automatic_apk=1;; esac
    automatic_skip=0
    case "$2:$automatic_desired:$automatic_apk" in
        apply:on:1) ;;
        apply:*) automatic_skip=1;;
        revert:on:1) automatic_skip=1;;
    esac
    if [ "$automatic_skip" -eq 1 ]; then
        case "$automatic_desired" in on|off) ;; *) automatic_desired=off;; esac
        sg_print state=not-implemented restart=none info.skipped=true \
            "info.desired=$automatic_desired" 'detail=Automatic module intent changed'
        exit 0
    fi
fi
if [ "$2" = watch ]; then
    [ ! -f "$SG_DATA_ROOT/stock/paused" ] || refuse 3 conflict 'Automatic module calls paused'
    [ "$(cat "$SG_DATA_ROOT/desired/$1" 2>/dev/null)" = on ] || refuse 3 conflict 'Module desired off'
    watch_events=
    while IFS='=' read -r field value; do
        [ "$field" = watch ] && watch_events=$value
    done < "$manifest"
    case ",$watch_events," in *,"$3",*) ;; *) refuse 2 failed 'Invalid command';; esac
    /system/bin/sh "$script" watch "$3"
    exit $?
fi
relation() {
    relation_id=$1; relation_field=$2
    for graph_file in "$base/modules.graph" "$SG_DATA_ROOT/installed.graph"; do
        [ -f "$graph_file" ] || continue
        while IFS='	' read -r graph_id graph_dep graph_exc; do
            if [ "$graph_id" = "$relation_id" ]; then
                case "$relation_field" in
                    depends) sg_print "${graph_dep#depends=}" ;;
                    excludes) sg_print "${graph_exc#excludes=}" ;;
                esac
            elif [ "$relation_field" = excludes ]; then
                case ",${graph_exc#excludes=}," in *,"$relation_id",*) sg_print "$graph_id" ;; esac
            fi
        done < "$graph_file"
    done
}
desired_on() { [ -f "$SG_DATA_ROOT/desired/$1" ] && [ "$(cat "$SG_DATA_ROOT/desired/$1")" = on ]; }
if [ "$2" = set ]; then
    # Settings exist only for installed packages; a running module is reverted and
    # applied again so no target of the previous value survives.
    [ ! -f "$SG_DATA_ROOT/uninstall/pending" ] || refuse 3 conflict 'Uninstall pending'
    ! sg_module_builtin "$base" "$1" || refuse 2 failed 'Invalid command'
    . "$base/lib/hsm.sh"
    hsm_setting_decl "$3" && hsm_setting_valid "$4" || refuse 2 failed 'Invalid setting value'
    # A bundled raw_shell module may refuse a value that clashes with its other settings
    # (read-only setting-ok verb; exit 2 means the module has no such check).
    if grep -Fxq raw_shell=1 "$manifest"; then
        setting_check=$(/system/bin/sh "$script" setting-ok "$3" "$4" 2>&1)
        case $? in 0|2) ;; *)
            setting_detail=
            while IFS='=' read -r field value; do [ "$field" != detail ] || setting_detail=$value; done <<EOF
$setting_check
EOF
            refuse 3 conflict "${setting_detail:-Setting not allowed}" ;;
        esac
    fi
    settings=$SG_DATA_ROOT/settings/$1
    mkdir -p "$settings" && chmod 700 "$SG_DATA_ROOT/settings" "$settings" &&
        sg_write "$4" > "$settings/$3.tmp.$$" && mv "$settings/$3.tmp.$$" "$settings/$3" ||
        refuse 1 failed 'Could not save setting'
    if ! desired_on "$1"; then
        sg_print state=off restart=none 'detail=Setting saved'
        exit 0
    fi
    /system/bin/sh "$script" revert > /dev/null 2>&1 || refuse 1 failed 'Could not restore before applying the new setting'
    /system/bin/sh "$script" apply
    exit $?
fi
if [ "$2" = action ]; then
    # A ui.txt button re-runs apply.sh of a running installed module with action_is NAME true.
    [ ! -f "$SG_DATA_ROOT/uninstall/pending" ] || refuse 3 conflict 'Uninstall pending'
    [ ! -f "$SG_DATA_ROOT/stock/paused" ] || refuse 3 conflict 'Automatic module calls paused'
    ! sg_module_builtin "$base" "$1" || refuse 2 failed 'Invalid command'
    grep -Fxq kind=action "$manifest" || desired_on "$1" || refuse 3 conflict 'Turn the module on first'
    /system/bin/sh "$script" action "$3"
    exit $?
fi
if [ "$2" = apply ]; then
    ! grep -Fxq kind=action "$manifest" || refuse 2 failed 'Invalid command'
    [ ! -f "$SG_DATA_ROOT/uninstall/pending" ] || { refuse 3 conflict 'Uninstall pending'; }
    [ -f "$base/modules.graph" ] || refuse 1 failed 'Could not prepare module operation'
    old_ifs=$IFS; IFS=',
'
    for dep in $(relation "$1" depends); do
        [ -z "$dep" ] || desired_on "$dep" || { refuse 3 conflict "Dependency off: $dep"; }
    done
    for excluded in $(relation "$1" excludes); do
        [ -z "$excluded" ] || ! desired_on "$excluded" || { refuse 3 conflict "Excluded module on: $excluded"; }
    done
    IFS=$old_ifs
    if clash=$(sg_module_clash "$base" "$1"); then refuse 3 conflict "Conflicts with module on: $clash"; fi
else
    # A direct root call may not leave an enabled dependent behind.
    for other in $(sg_module_list "$base"); do
        [ "$other" = "$1" ] && continue
        case ",$(relation "$other" depends)," in *,"$1",*)
            desired_on "$other" && { refuse 3 conflict "Dependent on: $other"; } ;;
        esac
    done
fi
sg_print "$(date +%s) $1 $2" > "$SG_DATA_ROOT/journal.tmp.$$" &&
    mv "$SG_DATA_ROOT/journal.tmp.$$" "$SG_DATA_ROOT/journal" || refuse 1 failed 'Could not prepare module operation'
result=$SG_DATA_ROOT/result.$$
/system/bin/sh "$script" "$2" > "$result" 2>&1
code=$?
if [ "$code" -eq 0 ] && [ "$2" = apply ]; then
    # common.sh is already loaded above: sourcing it again only redefines every function,
    # which some mksh builds (Ubuntu R59) take seconds to do.
    sg_reapply_binds >> "$result" 2>&1 || code=1
fi
dd if="$result" bs=1 count=4096 2>/dev/null
if [ "$code" -ne 0 ]; then
    while IFS='=' read -r field value; do
        [ "$field" != info.restore_conflict ] || sg_print "detail=$value"
    done < "$result"
fi
if [ "$code" -eq 0 ]; then
    case "$2" in
        apply) grep -q '^state=on$' "$result" ||
            grep -q '^state=pending-restart$' "$result" || code=1 ;;
        revert) grep -q '^state=off$' "$result" || {
            grep -q '^state=pending-restart$' "$result" &&
                grep -q '^restart=head_unit$' "$result" &&
                grep -q '^info.desired=off$' "$result" || code=1
        } ;;
    esac
fi
if [ "$code" -eq 0 ]; then
    case "$2" in apply) value=on;; revert) value=off;; esac
    sg_write "$value" > "$SG_DATA_ROOT/desired/$1.tmp.$$" &&
        mv "$SG_DATA_ROOT/desired/$1.tmp.$$" "$SG_DATA_ROOT/desired/$1" || code=1
    if [ "$code" -eq 0 ] && [ "$2" = apply ]; then
        rm -f "$SG_DATA_ROOT/stock/paused" "$SG_DATA_ROOT/stock/result"
    fi
fi
rm -f "$result"
exit "$code"
