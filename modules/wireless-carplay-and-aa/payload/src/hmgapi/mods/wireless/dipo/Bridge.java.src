package hmgapi.mods.wireless.dipo;
// Modified by HMG-Seogaemo: no stock hotspot start while the wifi module runs the USB CarPlay hotspot;
// the stock Phone Projection switch to Android Auto stops the bridged CarPlay (ProjectionSwitch).

import android.bluetooth.BluetoothAdapter;
import android.bluetooth.BluetoothDevice;
import android.content.BroadcastReceiver;
import android.content.Context;
import android.content.Intent;
import android.content.IntentFilter;
import android.net.wifi.WifiConfiguration;
import android.os.Handler;
import android.os.HandlerThread;
import android.phoneprojection.IPPActionListener;

import com.broadcom.bt.hfdevice.hfbtcm.HfDeviceBTCMManager;
import com.broadcom.bt.hfdevice.hfbtcm.HfDeviceStatusListener;
import com.tcc.iap2.IIap2Listener;
import com.tcc.iap2.IIap2Service;
import com.tcc.iap2.Iap2ListenerInfo;
import com.tcc.iap2.Iap2NotiMsg;

import java.lang.reflect.Method;
import java.nio.charset.Charset;
import java.util.ArrayList;

import hmgapi.hook.Points;
import hmgapi.mods.wireless.StockHotspot;
import hmgapi.mods.wireless.UsbHotspot;

/**
 * Wireless CarPlay's Bluetooth bridge, in DiPO (from the bridge build, com.ev6.cpwl).
 *
 * An iPhone pairs over Bluetooth; wireless CarPlay starts with iAP2 over Bluetooth
 * (RFCOMM/SPP), which the iAP2 server here can't do by itself. The bridge carries it:
 * SPP data from Broadcom's Bluetooth manager goes into the iAP2 server as transport data
 * (Iap2SvcTransportReadDone), and what the server sends back (notification 80) goes out
 * over SPP. The iAP2 server opens the session for BT_ATTACHED (HMG-API's hook there, part
 * "bridge"). Once the phone has joined the hotspot and the CarPlay session runs, iAP2
 * moves into the CarPlay session's own channel: bytes the phone sends there
 * (oniAPSendMessage) go to the server, and what the server sends for it
 * (notification 81) goes out through the CarPlay library.
 *
 * HMG-API binds the iAP2 server and hooks Broadcom's manager (a library), and only
 * observes DiPO's CarPlay callbacks; DiPO's own iAP2 listener is told to ignore what
 * belongs to the bridge's sessions (Dipo's hooks).
 *
 * Phone Projection's own switch (Android Auto chosen, CarPlay disconnected) stops the bridged
 * session and holds that iPhone off (ProjectionSwitch); while Android Auto runs, no session starts.
 *
 * persist.ev6.cpwl.enable=0 turns it off; persist.ev6.cpwl.handover=created moves iAP2
 * into the CarPlay channel as soon as the session is created (default: on its first data).
 */
final class Bridge {
    static final String ACTION_ATTACH = "com.ev6.cpwl.BT_ATTACHED", ACTION_DETACH = "com.ev6.cpwl.BT_DETACHED";
    static final String IAP2_PKG = "com.tcc.iap2server";
    static final int APPLE_VENDOR_ID = 76;
    /** iAP2 components: 1 USB, 4 Bluetooth CarPlay, 5 the CarPlay session's channel */
    static final int COMPONENT_USB = 1, COMPONENT_BT_CARPLAY = 4, COMPONENT_CARPLAY_CLIENT = 5;
    static final int LISTENER_EXTERNAL_BT_TRANSPORT = 1024, LISTENER_EXTERNAL_CARPLAY_TRANSPORT = 2048;
    static final int NOTI_IDENTIFICATION_ACCEPTED = 0, NOTI_TRANSPORT_IDENTIFIER = 24;
    static final int NOTI_BT_TRANSPORT_DATA = 80, NOTI_CARPLAY_CLIENT_TRANSPORT_DATA = 81, OBJ_BLOB = 11;
    static final int MAX_PENDING = 64;
    static final long SPP_CONNECT_DELAY_MS = 3000;
    static final int SPP_DISCONNECTED = 0, SPP_CONNECTED = 2, EVENT_BTCM_CONNECTED = 2;

    static volatile String sAddr;
    static volatile HfDeviceBTCMManager sBtcm;
    static volatile Object sCp;
    static volatile boolean sCpClient, sCpConnected, sCpWireless, sSession, sUsb;
    static volatile IIap2Service sIap2;
    /** the phone's Bluetooth address from its last iAP2 session (DiPO's first-connect notice) */
    static volatile String sLastBtId;
    static final ProjectionSwitch SWITCH = new ProjectionSwitch();
    /**
     * Which phone the bridge serves when two phones are around (BridgePeers, item 11a). Null when the connection owner
     * is off: then every call site runs the single-phone code exactly as before.
     */
    static volatile BridgePeers sPeers;
    /** the CarPlay connection owner (ProjectionOwner); null when off (kill switch, or points missing) */
    static volatile ProjectionOwner sOwner;
    static ClassLoader cl;
    static Context context;
    private static int sCpFail, sCpSent;
    private static Handler sHandler, sCpTx;
    private static Method sNativeSend;
    private static final ArrayList<byte[]> sPendingIn = new ArrayList<byte[]>();
    private static BtListener sBt;
    private static TxListener sTx;
    private static PpListener sPp;

    private Bridge() {}

    static void log(String m) {
        Dipo.log("bridge: " + m);
    }

    static void error(String m, Throwable t) {
        Dipo.error("bridge: " + m, t);
    }

    /** DiPO registered its listener with Broadcom's manager (the manager is connected): ours goes next to it */
    static void onBtcmReady(HfDeviceBTCMManager m) {
        if (m == null) return;
        try {
            sBtcm = m;
            synchronized (Bridge.class) {
                if (sBt == null) sBt = new BtListener();
            }
            m.registerHfDeviceStatusListener(sBt);
            log("BTCM listener registered");
            BluetoothDevice d = m.IbtcmGetHfpConnectedDevice();
            if (d != null && isApple(d)) scheduleSppConnect(d.getAddress());
        } catch (Throwable t) {
            error("onBtcmReady", t);
        }
    }

    static boolean isOurs(Object listener) {
        return listener != null && listener == sBt;
    }

    /** the iAP2 server is bound: register for Bluetooth and CarPlay-channel transport data */
    static void onIap2Bound(IIap2Service s) {
        if (s == null) return;
        try {
            sIap2 = s;
            synchronized (Bridge.class) {
                if (sTx == null) sTx = new TxListener();
            }
            Iap2ListenerInfo info = new Iap2ListenerInfo();
            info.onSetSupportType(LISTENER_EXTERNAL_BT_TRANSPORT | LISTENER_EXTERNAL_CARPLAY_TRANSPORT);
            info.onSetListenerName("EV6_CPWL_BT");
            log("Iap2SvcInit(EV6_CPWL_BT, 0xc00) = " + s.Iap2SvcInit(sTx, info));
        } catch (Throwable t) {
            error("onIap2Bound", t);
        }
    }

    static boolean enabled() {
        return !"0".equals(prop("persist.ev6.cpwl.enable", "1"));
    }

    /** a system property (android.os.SystemProperties isn't in the public SDK) */
    static String prop(String key, String fallback) {
        try {
            return (String) Class.forName("android.os.SystemProperties").getMethod("get", String.class, String.class).invoke(null, key, fallback);
        } catch (Throwable t) {
            return fallback;
        }
    }

    static synchronized Handler handler() {
        if (sHandler == null) {
            HandlerThread t = new HandlerThread("hmgapi-cpwl");
            t.start();
            sHandler = new Handler(t.getLooper());
        }
        return sHandler;
    }

    static boolean isApple(BluetoothDevice d) {
        if (d == null) return false;
        try {
            Object v = BluetoothDevice.class.getMethod("getVendor").invoke(d);
            if (v instanceof Integer) return (Integer) v == APPLE_VENDOR_ID;
        } catch (Throwable t) {
            // no vendor id on this build: by name
        }
        try {
            String n = d.getName();
            return n != null && (n.contains("iPhone") || n.contains("iPad"));
        } catch (Throwable t) {
            return false;
        }
    }

    /** the bridge's live session for a phone: a Bluetooth attach, a CarPlay session or the CarPlay channel */
    static boolean liveNow() {
        return sSession || sCpClient || sCpWireless;
    }

    /** the queue token of the current decisions (0 when the peers are off: nothing is ever stale then) */
    static int token() {
        BridgePeers p = sPeers;
        return p == null ? 0 : p.token();
    }

    /** a queued job whose decision changed is dropped (logged once); true when it may run */
    static boolean tokenOk(int captured, String what) {
        BridgePeers p = sPeers;
        if (p == null || p.current(captured)) return true;
        log("dropped " + what + ": superseded by a newer decision");
        return false;
    }

    /** bonded, or unknown (a failed lookup keeps the old behaviour); not when no bond or still bonding */
    static boolean bonded(String addr) {
        try {
            BluetoothAdapter adapter = BluetoothAdapter.getDefaultAdapter();
            if (adapter == null) return true;
            int state = adapter.getRemoteDevice(addr).getBondState();
            return state != BluetoothDevice.BOND_NONE && state != BluetoothDevice.BOND_BONDING;
        } catch (Throwable t) {
            return true;
        }
    }

    /** allowAuto: may this phone start a session now? Logs the reason once when not; always true with the peers off */
    static boolean mayAttach(String addr, String what) {
        BridgePeers p = sPeers;
        if (p == null) return true;
        String why = p.denyReason(addr, bonded(addr), SWITCH.isHeld(addr), liveNow() ? sAddr : null);
        if (why == null) return true;
        log("no " + what + " for " + BridgePeers.mask(addr) + ": " + why);
        return false;
    }

    static void scheduleSppConnect(final String addr) {
        if (addr == null || !enabled() || sUsb || sSession || sCpWireless || SWITCH.isHeld(addr)) return;
        final int token = token();
        handler().postDelayed(new Runnable() {
            @Override
            public void run() {
                try {
                    HfDeviceBTCMManager m = sBtcm;
                    if (m == null || sUsb || sSession || sCpWireless || !enabled() || SWITCH.isHeld(addr)) return;
                    if (!tokenOk(token, "SPP connect for " + BridgePeers.mask(addr))) return;
                    if (!mayAttach(addr, "SPP connect")) return;
                    if (m.IbtcmIsSppConnectedDevice(addr)) log("SPP already up for " + addr);
                    else log("IbtcmSppConnect(" + addr + ") = " + m.IbtcmSppConnect(addr));
                } catch (Throwable t) {
                    error("sppConnect", t);
                }
            }
        }, SPP_CONNECT_DELAY_MS);
    }

    static void onSppUp(final String addr) {
        BridgePeers peers = sPeers;
        if (peers != null) peers.sppUp(addr);
        if (addr == null || sSession) return;
        if (peers == null) {
            sAddr = addr;
        } else {
            // a phone's SPP coming up never takes the address from a phone with a live session (item 11a)
            String served = BridgePeers.arbitrate(sAddr, addr, liveNow());
            if (!BridgePeers.sameAddr(served, addr)) {
                log("kept " + BridgePeers.mask(sAddr) + " (live session), " + BridgePeers.mask(addr) + " SPP up only");
            }
            sAddr = served;
        }
        if (sCpClient || sCpWireless || !enabled() || sUsb) return;
        if (SWITCH.isHeld(addr)) {
            log("no session for " + addr + ": held off by Phone Projection's switch");
            return;
        }
        if (androidAutoActive()) {
            log("no session for " + addr + ": Android Auto is connected");
            return;
        }
        if (!mayAttach(addr, "session")) return;
        sSession = true;
        SWITCH.sessionEnded();
        final int token = token();
        handler().post(new Runnable() {
            @Override
            public void run() {
                try {
                    if (!tokenOk(token, "session for " + BridgePeers.mask(addr))) {
                        sSession = false;
                        return;
                    }
                    Context c = context;
                    if (c == null) {
                        log("no context, cannot start session");
                        sSession = false;
                        return;
                    }
                    ensureHotspot(c);
                    Intent i = new Intent(ACTION_ATTACH);
                    i.setPackage(IAP2_PKG);
                    i.addFlags(Intent.FLAG_RECEIVER_FOREGROUND);
                    i.putExtra("component", COMPONENT_BT_CARPLAY);
                    i.putExtra("serial", addr);
                    c.sendBroadcast(i);
                    log("BT_ATTACHED sent for " + addr);
                } catch (Throwable t) {
                    sSession = false;
                    error("onSppUp", t);
                }
            }
        });
    }

    /**
     * A session ended (or the phone's link dropped): re-attach the previous phone when it is eligible, else the first
     * other eligible phone whose SPP is up (B starts when A is not eligible), else nothing.
     */
    static void onUsbGone() {
        final String addr = sAddr;
        if (addr == null || sSession) return;
        final int token = token();
        handler().postDelayed(new Runnable() {
            @Override
            public void run() {
                try {
                    final HfDeviceBTCMManager m = sBtcm;
                    final BridgePeers peers = sPeers;
                    if (peers == null) {
                        if (m != null && !sUsb && !sSession && addr.equals(sAddr) && !SWITCH.isHeld(addr) && m.IbtcmIsSppConnectedDevice(addr)) onSppUp(addr);
                        return;
                    }
                    if (m == null || !tokenOk(token, "re-attach after the session")) return;
                    if (sUsb || sSession || liveNow()) return;
                    String next = BridgePeers.choose(addr, peers.sppUpList(), new BridgePeers.Eligible() {
                        @Override
                        public boolean ok(String candidate) {
                            return m.IbtcmIsSppConnectedDevice(candidate) && peers.denyReason(candidate, bonded(candidate), SWITCH.isHeld(candidate), null) == null;
                        }
                    });
                    if (next == null) return;
                    if (!BridgePeers.sameAddr(next, addr)) log("previous phone " + BridgePeers.mask(addr) + " not eligible, attaching " + BridgePeers.mask(next));
                    onSppUp(next);
                } catch (Throwable t) {
                    error("onUsbGone", t);
                }
            }
        }, SPP_CONNECT_DELAY_MS);
    }

    /** the kill switch persist.hmg_seogaemo.owner (default on; "0" off), read once when DiPO's bridge starts */
    static boolean ownerWanted() {
        return !"0".equals(prop("persist.hmg_seogaemo.owner", "1"));
    }

    /** the connection owner and the peer bookkeeping go on together (the owner's kill switch turns both off) */
    static void startOwner() {
        sPeers = new BridgePeers();
        sOwner = new ProjectionOwner(new OwnerEnv(context));
    }

    static void stopOwner() {
        sOwner = null;
        sPeers = null;
    }

    /**
     * Bond changes of the phones the bridge knows (item 11): a removed bond marks the phone and stops its session;
     * a re-pair clears the mark. Other devices are ignored. Only with the peers on.
     */
    static void registerBondReceiver(Context c) {
        if (sPeers == null || c == null) return;
        try {
            c.registerReceiver(new BroadcastReceiver() {
                @Override
                public void onReceive(Context ctx, Intent i) {
                    try {
                        BluetoothDevice d = i.getParcelableExtra(BluetoothDevice.EXTRA_DEVICE);
                        if (d == null) return;
                        final String addr = d.getAddress();
                        final int state = i.getIntExtra(BluetoothDevice.EXTRA_BOND_STATE, -1);
                        final int previous = i.getIntExtra(BluetoothDevice.EXTRA_PREVIOUS_BOND_STATE, -1);
                        handler().post(new Runnable() {
                            @Override
                            public void run() {
                                onBondChanged(addr, state, previous);
                            }
                        });
                    } catch (Throwable t) {
                        error("bond receiver", t);
                    }
                }
            }, new IntentFilter(BluetoothDevice.ACTION_BOND_STATE_CHANGED));
        } catch (Throwable t) {
            error("bond receiver", t);
        }
    }

    static void onBondChanged(String addr, int state, int previous) {
        BridgePeers peers = sPeers;
        if (peers == null || addr == null) return;
        ProjectionOwner o = sOwner;
        boolean known = BridgePeers.sameAddr(addr, sAddr) || peers.isSppUp(addr) || SWITCH.isHeld(addr) || (o != null && o.knowsAddress(addr));
        if (!known) return;
        if (state == BluetoothDevice.BOND_NONE) {
            peers.markDeleted(addr);
            if (o != null) o.bondLost(addr);
            if (BridgePeers.sameAddr(addr, sAddr) && liveNow()) {
                SWITCH.hold(addr, true);
                peers.bump();
                sendDetach();
                log("bond removed for " + BridgePeers.mask(addr) + ": session stopped and held off");
            } else {
                log("bond removed for " + BridgePeers.mask(addr) + ": not attached until paired again");
            }
        } else if (state == BluetoothDevice.BOND_BONDED && (previous == BluetoothDevice.BOND_BONDING || peers.isDeleted(addr))) {
            peers.clearDeleted(addr);
            if (o != null) o.bondRestored(addr);
            log("paired again " + BridgePeers.mask(addr));
        }
    }

    /**
     * Phone Projection cancelled a connection (cancelConnectionPP, CarPlay, wireless): when that phone is the bridged
     * or the connecting one, it is held off like a user disconnect, and its live session (if any) is stopped.
     */
    static void onCancelConnection(final int type, final String addr, final int transfer) {
        if (type != ProjectionSwitch.TYPE_CARPLAY || transfer != ProjectionSwitch.TRANSFER_WIRELESS || sPeers == null) return;
        handler().post(new Runnable() {
            @Override
            public void run() {
                try {
                    BridgePeers peers = sPeers;
                    if (peers == null) return;
                    String target = addr == null || addr.length() == 0 ? sAddr : addr;
                    if (target == null) return;
                    if (!BridgePeers.sameAddr(target, sAddr) && !peers.isSppUp(target)) {
                        log("cancel for " + BridgePeers.mask(target) + ": not the bridged or connecting phone");
                        return;
                    }
                    boolean stop = liveNow() && BridgePeers.sameAddr(target, sAddr);
                    SWITCH.hold(target, stop);
                    peers.bump();
                    ProjectionOwner o = sOwner;
                    if (o != null) o.userDisconnected(target);
                    if (stop) sendDetach();
                    log("connection of " + BridgePeers.mask(target) + " cancelled: held off" + (stop ? ", session stopped" : ""));
                } catch (Throwable t) {
                    error("cancel", t);
                }
            }
        });
    }

    static void ownerCreated() {
        ProjectionOwner o = sOwner;
        if (o != null) o.serviceCreated();
    }

    static void ownerDestroyed() {
        ProjectionOwner o = sOwner;
        if (o != null) o.serviceDestroyed();
    }

    /** CarPlayService.onSessionDetails: the native session's device id, MAC address and name bytes */
    static void onCpSessionDetails(String deviceId, String mac, byte[] name) {
        ProjectionOwner o = sOwner;
        if (o == null) return;
        o.details(deviceId, mac, name == null ? "" : new String(name, Charset.forName("UTF-8")));
    }

    static void onCpSessionCreated(Object cp) {
        ProjectionOwner owner = sOwner;
        if (owner != null) owner.created(sAddr);
        if (cp != null) sCp = cp;
        log("CarPlay session created (usb=" + sUsb + " btAddr=" + sAddr + ")");
        if ("created".equals(prop("persist.ev6.cpwl.handover", "data")) && !sUsb && sAddr != null) {
            startCpClient("session created");
        }
    }

    static void onCpSessionStarted(int transport) {
        ProjectionOwner owner = sOwner;
        if (owner != null) owner.started(transport);
        sCpWireless = transport == 1 && !sUsb;
        SWITCH.sessionEnded();
        log("CarPlay session started transport=" + transport + " wireless=" + sCpWireless);
    }

    /** iAP2 bytes from the phone over the CarPlay channel: to the iAP2 server (buffered until its session is up) */
    static void onCpIapIn(Object cp, byte[] data, int len) {
        try {
            if (cp != null) sCp = cp;
            if (data == null || len <= 0 || sUsb) return;
            if (len >= data.length) len = data.length;
            traceIapIn(data, len);
            byte[] b = new byte[len];
            System.arraycopy(data, 0, b, 0, len);
            if (!sCpClient) startCpClient("iAP2 data from CarPlay channel");
            IIap2Service s = sIap2;
            if (sCpConnected && s != null) {
                flushPending(s);
                s.Iap2SvcTransportReadDone(b, len);
            } else {
                synchronized (sPendingIn) {
                    if (sPendingIn.size() < MAX_PENDING) sPendingIn.add(b);
                }
            }
            decodeLanes(b);
        } catch (Throwable t) {
            error("onCpIapIn", t);
        }
    }

    private static final CpLaneDecoder laneDecoder = new CpLaneDecoder();
    private static long laneErrorAt;

    private static void decodeLanes(byte[] data) {
        try {
            final CpLaneDecoder.Info[] lanes = laneDecoder.feed(data, data.length);
            int errors = laneDecoder.takeErrors();
            long now = System.currentTimeMillis();
            if (errors > 0 && (laneErrorAt == 0 || now - laneErrorAt >= 30000L)) {
                laneErrorAt = now;
                log("0x5204 decode errors=" + errors + " (one log/30s)");
            }
            if (lanes.length > 0 && Dipo.turnsHandler != null) Dipo.post(new Runnable() {
                @Override public void run() {
                    if (Dipo.turns != null) for (CpLaneDecoder.Info lane : lanes) Dipo.turns.rawLanes(lane);
                }
            });
        } catch (Throwable t) {
            long now = System.currentTimeMillis();
            if (laneErrorAt == 0 || now - laneErrorAt >= 30000L) {
                laneErrorAt = now;
                log("0x5204 decode failed: " + t.getClass().getSimpleName());
            }
        }
    }

    private static int sInCount;
    private static final java.util.HashMap<Integer, Integer> sInMsg = new java.util.HashMap<Integer, Integer>();

    /** diagnostics only: counts inbound iAP2 packets and control-session message ids; never touches the bytes */
    private static void traceIapIn(byte[] d, int len) {
        try {
            int n = ++sInCount;
            boolean dev = Dipo.dev();
            if (dev && (n <= 5 || n % 200 == 0)) log("iAP2 in #" + n + " len=" + len);
            // link packet: 0xFF5A start, len(2), control, seq, ack, session; payload at 9. Control session payload: 0x4040, len(2), msg id(2)
            if (len >= 15 && (d[0] & 0xff) == 0xFF && (d[1] & 0xff) == 0x5A && (d[9] & 0xff) == 0x40 && (d[10] & 0xff) == 0x40) {
                int id = ((d[13] & 0xff) << 8) | (d[14] & 0xff);
                Integer c = sInMsg.get(id);
                sInMsg.put(id, c == null ? 1 : c + 1);
                if (c == null && sInMsg.size() <= 32) log("iAP2 in first control msg 0x" + Integer.toHexString(id) + " (len " + len + ", at in #" + n + ")");
                else if (c != null && dev && (c + 1) % 100 == 0) log("iAP2 in control msg 0x" + Integer.toHexString(id) + " x" + (c + 1));
            } else if (dev && n <= 5) {
                log("iAP2 in #" + n + " not a control-session packet, first bytes " + (d[0] & 0xff) + "," + (len > 1 ? d[1] & 0xff : -1) + "," + (len > 9 ? d[9] & 0xff : -1));
            }
        } catch (Throwable t) {
            // diagnostics only
        }
    }

    static void onCpSessionFinalized(int type) {
        ProjectionOwner owner = sOwner;
        if (owner != null) owner.finalized(type);
        BridgePeers peers = sPeers;
        if (peers != null) peers.bump();
        try {
            log("CarPlay session finalized type=" + type + " cpClient=" + sCpClient);
            boolean client = sCpClient, wireless = sCpWireless;
            laneDecoder.reset();
            if (Dipo.turnsHandler != null) Dipo.post(new Runnable() {
                @Override public void run() { if (Dipo.turns != null) Dipo.turns.disconnected(); }
            });
            sCpWireless = false;
            sCpClient = false;
            sCpConnected = false;
            NOW_PLAYING.reset();
            synchronized (sPendingIn) {
                sPendingIn.clear();
            }
            if (client) sendDetach();
            if (client || wireless) onUsbGone();
            SWITCH.sessionEnded();
        } catch (Throwable t) {
            error("onCpSessionFinalized", t);
        }
    }

    /**
     * DiPO's iAP2 listener: ignore the Bluetooth and CarPlay-channel sessions ending while wireless CarPlay
     * is up, except after Phone Projection's switch asked to stop it: then DiPO ends CarPlay as for a USB phone
     */
    static boolean dipoIgnoreDisconnect(int component) {
        boolean ignore = !SWITCH.stopping() && (sCpClient || sCpWireless) && (component == COMPONENT_BT_CARPLAY || component == COMPONENT_CARPLAY_CLIENT);
        if (ignore) log("DiPO: ignoring iAP2 disconnect comp=" + component + " (wireless CarPlay up)");
        return ignore;
    }

    /** DiPO's iAP2 listener: the CarPlay-channel session's identification isn't a new phone */
    static boolean dipoDropNoti(int what) {
        boolean drop = sCpClient && (what == NOTI_IDENTIFICATION_ACCEPTED || what == NOTI_TRANSPORT_IDENTIFIER);
        if (drop) log("DiPO: dropping iAP2 noti " + what + " from the CarPlay-channel session");
        if (drop && NOW_PLAYING.due(Dipo.nowPlaying, sCpClient, what)) startNowPlaying(NOW_PLAYING.session(), 1);
        return drop;
    }

    /** song info on wireless: DiPO only starts it for USB */
    static final NowPlaying NOW_PLAYING = new NowPlaying();

    private static void startNowPlaying(final int session, final int tryNo) {
        handler().postDelayed(new Runnable() {
            @Override
            public void run() {
                final IIap2Service s = sIap2;
                String r = NOW_PLAYING.attempt(session, tryNo, sCpClient, new NowPlaying.Server() {
                    @Override
                    public boolean start() throws Exception {
                        return s != null && s.Iap2SvcNowPlayingStart();
                    }
                });
                if (r == null) startNowPlaying(session, tryNo + 1);
                else if (!r.isEmpty()) log(r);
            }
        }, NowPlaying.DELAY_MS);
    }

    static void startCpClient(final String why) {
        if (sCpClient) return;
        NOW_PLAYING.reset();
        sCpClient = true;
        sCpConnected = false;
        final String addr = cpAddress();
        final int token = token();
        handler().post(new Runnable() {
            @Override
            public void run() {
                try {
                    Context c = context;
                    if (c == null) return;
                    if (!tokenOk(token, "CarPlay-channel handover")) {
                        sCpClient = false;
                        sCpConnected = false;
                        return;
                    }
                    Intent i = new Intent(ACTION_ATTACH);
                    i.setPackage(IAP2_PKG);
                    i.addFlags(Intent.FLAG_RECEIVER_FOREGROUND);
                    i.putExtra("component", COMPONENT_CARPLAY_CLIENT);
                    i.putExtra("serial", addr);
                    c.sendBroadcast(i);
                    log("iAP2 handover to CarPlay channel requested (" + why + ")");
                } catch (Throwable t) {
                    error("startCpClient", t);
                }
            }
        });
    }

    /** the phone the CarPlay channel is handed to: the owner's attributed phone when known, else the bridge's */
    static String cpAddress() {
        ProjectionOwner o = sOwner;
        String attributed = o == null ? null : o.activeAddress();
        return attributed != null ? attributed : sAddr;
    }

    static void onCpClientConnected() {
        sCpConnected = true;
        IIap2Service s = sIap2;
        if (s != null) flushPending(s);
    }

    private static void flushPending(IIap2Service s) {
        ArrayList<byte[]> all;
        synchronized (sPendingIn) {
            if (sPendingIn.isEmpty()) return;
            all = new ArrayList<byte[]>(sPendingIn);
            sPendingIn.clear();
        }
        for (byte[] b : all) {
            try {
                s.Iap2SvcTransportReadDone(b, b.length);
            } catch (Throwable t) {
                error("flushPending", t);
            }
        }
        log("flushed " + all.size() + " buffered CarPlay-channel packets");
    }

    private static synchronized Handler cpTx() {
        if (sCpTx == null) {
            HandlerThread t = new HandlerThread("hmgapi-cp-tx");
            t.start();
            sCpTx = new Handler(t.getLooper());
        }
        return sCpTx;
    }

    private static Method nativeSend() {
        if (sNativeSend == null) sNativeSend = Points.method(cl, "dipo.carplay.native_iap_send");
        return sNativeSend;
    }

    /** iAP2 bytes from the server for the CarPlay channel: out through the CarPlay library */
    static void writeCp(byte[] data) {
        final Object cp = sCp;
        if (cp == null || data == null || data.length == 0 || !sCpClient) return;
        final byte[] b = data.clone();
        cpTx().post(new Runnable() {
            @Override
            public void run() {
                try {
                    Object r = nativeSend().invoke(cp, b, b.length);
                    int rc = r instanceof Integer ? (Integer) r : -1;
                    if (rc == 0) {
                        sCpSent++;
                        if (sCpSent <= 3 || sCpSent % 200 == 0) log("CarPlay-channel iAP2 sent " + b.length + " bytes (#" + sCpSent + ")");
                    } else {
                        sCpFail++;
                        if (sCpFail <= 5 || sCpFail % 50 == 0) log("CarPlay-channel iAP2 send failed rc=" + rc + " len=" + b.length);
                    }
                } catch (Throwable t) {
                    error("writeCp native", t);
                }
            }
        });
    }

    static void onSppDown(String addr) {
        SWITCH.linkDown(addr);
        BridgePeers peers = sPeers;
        if (peers != null) peers.sppDown(addr);
        if (addr == null || !addr.equals(sAddr)) return;
        if (peers != null && liveNow()) peers.bump();
        if (sCpWireless) {
            sSession = false;
            startCpClient("bluetooth dropped during wireless CarPlay");
            return;
        }
        sAddr = null;
        if (sSession) {
            sSession = false;
            sendDetach();
        }
    }

    static void sendDetach() {
        handler().post(new Runnable() {
            @Override
            public void run() {
                try {
                    Context c = context;
                    if (c == null) return;
                    Intent i = new Intent(ACTION_DETACH);
                    i.setPackage(IAP2_PKG);
                    i.addFlags(Intent.FLAG_RECEIVER_FOREGROUND);
                    c.sendBroadcast(i);
                    log("BT_DETACHED sent");
                } catch (Throwable t) {
                    error("sendDetach", t);
                }
            }
        });
    }

    /** SPP data from the phone: to the iAP2 server */
    static void onSppData(BluetoothDevice d, byte[] data, int len) {
        try {
            String addr = sAddr;
            IIap2Service s = sIap2;
            if (addr == null || s == null || d == null || data == null || len <= 0 || !sSession || !addr.equals(d.getAddress())) return;
            if (len >= data.length) len = data.length;
            if (len != data.length) {
                byte[] b = new byte[len];
                System.arraycopy(data, 0, b, 0, len);
                data = b;
            }
            s.Iap2SvcTransportReadDone(data, len);
        } catch (Throwable t) {
            error("onSppData", t);
        }
    }

    /** iAP2 bytes from the server for the Bluetooth session: out over SPP */
    static void writeSpp(byte[] data) {
        try {
            String addr = sAddr;
            HfDeviceBTCMManager m = sBtcm;
            if (addr == null || m == null || data == null || data.length == 0 || !sSession) return;
            if (!m.IbtcmSppOutPutStreamWrite(addr, data)) log("SPP write failed, " + data.length + " bytes");
        } catch (Throwable t) {
            error("writeSpp", t);
        }
    }

    /** Is Android Auto connected? (GPM refuses a wireless Android Auto start while CarPlay is; the bridge does the same) */
    static boolean androidAutoActive() {
        Context c = context;
        if (c == null) return false;
        try {
            Object gpm = Points.newInstance(null, "framework.gpm_manager.new", c);
            return Boolean.TRUE.equals(Points.call(null, "framework.gpm_manager.is_activated", gpm));
        } catch (Throwable t) {
            return false;
        }
    }

    /** Phone Projection's requests (PPService passes them to every listener; DiPO has none of its own) */
    static void registerProjectionListener(Context c) {
        try {
            Object pp = c == null ? null : c.getSystemService("phoneprojection");
            if (pp == null) {
                log("no phoneprojection service: Phone Projection's switch is not followed");
                return;
            }
            synchronized (Bridge.class) {
                if (sPp != null) return;
                sPp = new PpListener();
            }
            pp.getClass().getMethod("addPPActionListener", IPPActionListener.class).invoke(pp, sPp);
            log("Phone Projection listener registered");
        } catch (Throwable t) {
            error("Phone Projection listener", t);
        }
    }

    static void onProjection(final boolean connect, final int type, final String addr, final int transfer) {
        handler().post(new Runnable() {
            @Override
            public void run() {
                try {
                    String iphone = sAddr;
                    // with the peers on, the request's phone is honoured (a disconnect for another phone is ignored)
                    int action = SWITCH.request(connect, type, transfer, sPeers != null ? addr : null, iphone, liveNow());
                    String released = SWITCH.released();
                    log("Phone Projection " + (connect ? "connect" : "disconnect") + " type=" + type + " transfer=" + transfer
                            + (action == ProjectionSwitch.STOP ? ": stopping wireless CarPlay for " + iphone + ", held off"
                            : action == ProjectionSwitch.RESUME ? ": hold released for " + released : ": nothing to do"));
                    if (action == ProjectionSwitch.STOP) {
                        BridgePeers peers = sPeers;
                        if (peers != null) peers.bump();
                        ProjectionOwner o = sOwner;
                        if (o != null) o.userDisconnected(iphone);
                        sendDetach();
                    } else if (action == ProjectionSwitch.RESUME) {
                        String target = addr != null && addr.length() > 0 ? addr : released;
                        ProjectionOwner o = sOwner;
                        if (o != null && target != null) o.userConnected(target);
                        HfDeviceBTCMManager m = sBtcm;
                        if (target != null && m != null && m.IbtcmIsSppConnectedDevice(target)) onSppUp(target);
                        else scheduleSppConnect(target);
                    }
                } catch (Throwable t) {
                    error("Phone Projection request", t);
                }
            }
        });
    }

    /**
     * the head unit's hotspot in mode 2 (for connectivity), which wireless CarPlay joins. This is the only
     * place the module starts a hotspot; with the USB CarPlay hotspot (zygote snapshot) the wifi module
     * already runs hostapd on the adapter, so the stock wlan0 AP stays off and the attach goes on.
     */
    static void ensureHotspot(Context c) {
        if (UsbHotspot.active()) {
            log("USB hotspot " + UsbHotspot.iface() + " in use, stock hotspot not started");
            return;
        }
        try {
            Object wifi = c.getSystemService(Context.WIFI_SERVICE);
            if (wifi == null) return;
            Class<?> k = wifi.getClass();
            boolean on = false;
            int mode;
            try {
                on = (Boolean) k.getMethod("isWifiApEnabled").invoke(wifi);
            } catch (Throwable t) {
                // no such call: treat as off
            }
            try {
                mode = (Integer) k.getMethod("getWifiApMode").invoke(wifi);
            } catch (Throwable t) {
                mode = -1;
            }
            Object conf = k.getMethod("getWifiApConfiguration").invoke(wifi);
            // iAP2 (Iap2Service.OnSendWifiInformation) tells the phone the configuration's
            // ConnectivitySSID/ConnectivityPSK, but the hotspot runs its SSID/preSharedKey. Where
            // the two differ (Korean K5: random defaults) the phone is sent a network that is not
            // there. Store a configuration whose connectivity pair is the hotspot's own SSID and
            // password (the owner's settings stay as they are), and start the hotspot with that.
            Object use = syncConnectivity(conf);
            if (use != conf) {
                Object ok = null;
                try {
                    ok = k.getMethod("setWifiApConfiguration", WifiConfiguration.class).invoke(wifi, use);
                } catch (Throwable t) {
                    error("storing the connectivity SSID", t);
                }
                log("connectivity SSID and password set to the hotspot's own -> " + ok);
                // not stored: keep the owner's configuration (another one would overwrite it)
                if (!Boolean.TRUE.equals(ok)) use = conf;
            }
            if (on && mode == 2) {
                log("hotspot already up (mode 2)");
                return;
            }
            Object r = k.getMethod("setWifiApEnabledForConnectivity", WifiConfiguration.class, boolean.class).invoke(wifi, use, true);
            log("setWifiApEnabledForConnectivity -> " + r + " (was on=" + on + " mode=" + mode + ")");
            // Units whose connectivity call brings up nothing get the normal hotspot (contract "Peer info", stock_hotspot).
            StockHotspot.startLater(wifi, new StockHotspot.Log() {
                @Override
                public void log(String message) {
                    Bridge.log(message);
                }
            });
        } catch (Throwable t) {
            error("ensureHotspot", t);
        }
    }

    /**
     * conf itself when the framework has no ConnectivitySSID/ConnectivityPSK (Hyundai's fields,
     * read by reflection), they already equal SSID/preSharedKey, or conf has no SSID or password;
     * otherwise a copy whose connectivity pair is SSID/preSharedKey. Idea from the Korea
     * Projection K5 pull request (HMG-API 108, AGPL-3.0).
     */
    static Object syncConnectivity(Object o) {
        if (!(o instanceof WifiConfiguration)) return o;
        WifiConfiguration conf = (WifiConfiguration) o;
        try {
            Class<?> wc = WifiConfiguration.class;
            java.lang.reflect.Field fs = wc.getField("ConnectivitySSID"), fp = wc.getField("ConnectivityPSK");
            if (conf.SSID == null || conf.SSID.isEmpty() || conf.preSharedKey == null || conf.preSharedKey.isEmpty()) return conf;
            if (conf.SSID.equals(fs.get(conf)) && conf.preSharedKey.equals(fp.get(conf))) return conf;
            WifiConfiguration c = (WifiConfiguration) wc.getConstructor(WifiConfiguration.class).newInstance(conf);
            fs.set(c, conf.SSID);
            fp.set(c, conf.preSharedKey);
            return c;
        } catch (Throwable t) {
            return conf;
        }
    }

    /** Broadcom's status callbacks: an iPhone connects (start SPP), SPP up/down, SPP data */
    static final class BtListener extends HfDeviceStatusListener {
        @Override
        public void onBTCMDeviceConnectionEventChanged(BluetoothDevice d, int event, boolean[] profiles) {
            try {
                if (!isApple(d)) return;
                if (event != EVENT_BTCM_CONNECTED) {
                    SWITCH.linkDown(d.getAddress());
                    return;
                }
                log("iPhone BT connected: " + d.getAddress());
                if (SWITCH.connected(d.getAddress())) {
                    log("Phone Projection hold released for " + d.getAddress() + " (it reconnected)");
                    ProjectionOwner o = sOwner;
                    if (o != null) o.userConnected(d.getAddress());
                }
                scheduleSppConnect(d.getAddress());
            } catch (Throwable t) {
                error("connEvent", t);
            }
        }

        @Override
        public void onBTCMSppStatusChanged(BluetoothDevice d, int status) {
            if (d == null) return;
            try {
                if (!isApple(d)) return;
                String addr = d.getAddress();
                log("SPP status " + status + " for " + addr);
                if (status == SPP_CONNECTED) onSppUp(addr);
                else if (status == SPP_DISCONNECTED) onSppDown(addr);
            } catch (Throwable t) {
                error("sppStatus", t);
            }
        }

        @Override
        public void onBTCMSppInPutStreamChanged(BluetoothDevice d, byte[] buffer, int length) {
            onSppData(d, buffer, length);
        }
    }

    /** Phone Projection's connect/disconnect requests, as PPService passes them on */
    static final class PpListener extends IPPActionListener.Stub {
        @Override
        public void connectPP(int type, String address, String serial, int transfer) {
            onProjection(true, type, address, transfer);
        }

        @Override
        public void disconnectPP(int type, String address, String serial, int transfer) {
            onProjection(false, type, address, transfer);
        }

        @Override
        public void cancelConnectionPP(int type, String address, String serial, int transfer) {
            onCancelConnection(type, address, transfer);
        }

        @Override
        public void runningPP() {
            ProjectionOwner owner = sOwner;
            if (owner != null) owner.runningPP();
        }
    }

    /** the iAP2 server's side: USB and CarPlay-channel sessions, and transport data to send */
    static final class TxListener extends IIap2Listener.Stub {
        @Override
        public void connected(int component, String serial) {
            log("iAP2 connected comp=" + component);
            // what DiPO keeps as the current device (setCurrentIapDeviceName): a Bluetooth address is the notice's key
            if ((component == COMPONENT_USB || component == COMPONENT_BT_CARPLAY) && serial != null && serial.contains(":")) sLastBtId = serial;
            if (component == COMPONENT_USB) sUsb = true;
            else if (component == COMPONENT_CARPLAY_CLIENT) onCpClientConnected();
        }

        @Override
        public void disconnected(int component) {
            log("iAP2 disconnected comp=" + component);
            if (component == COMPONENT_USB) {
                sUsb = false;
                onUsbGone();
            } else if (component == COMPONENT_BT_CARPLAY) {
                sSession = false;
            } else if (component == COMPONENT_CARPLAY_CLIENT) {
                sCpConnected = false;
                NOW_PLAYING.reset();
            }
        }

        @Override
        public void notify(int what, int a1, int a2, Iap2NotiMsg msg) {
            if ((what != NOTI_BT_TRANSPORT_DATA && what != NOTI_CARPLAY_CLIENT_TRANSPORT_DATA) || msg == null) return;
            try {
                Iap2NotiMsg.Iap2ObjGroup g = msg.getItemGroup();
                if (g == null) return;
                for (int k = 0; k < g.getItemCnt(); k++) {
                    Iap2NotiMsg.Iap2ObjItem it = g.getObjItem(k);
                    if (it == null || it.getItemParamType() != OBJ_BLOB) continue;
                    if (what == NOTI_CARPLAY_CLIENT_TRANSPORT_DATA) writeCp(it.getItemByteArray());
                    else writeSpp(it.getItemByteArray());
                }
            } catch (Throwable t) {
                error("notify", t);
            }
        }
    }
}
