package hmgapi.mods.wireless.dipo;
// Modified by HMG-Seogaemo: Korean CarPlay turn-by-turn fixes (icon bands, lane colours, HUD distance rounding); see .agents/carplay-tbt-learnings.md.

import android.content.Context;
import android.text.format.DateFormat;

import com.tcc.iap2.Iap2NotiMsg;

import java.util.Calendar;
import java.util.LinkedHashMap;

import hmgapi.hook.Car;
import hmgapi.hook.Cluster;

/**
 * CarPlay turn-by-turn on the cluster and HUD: a port of the turn-by-turn build's DiPO
 * route guidance manager (e/u, with its route update e/c and maneuver e/v), fed by
 * HMG-API's own iAP2 listener instead of DiPO's, and sending through HMG-API's Cluster API.
 * DiPO's own manager only exists when stepofspec is 999 or more, and stays off.
 *
 * The iPhone sends RouteGuidanceUpdate (120: state, distances, the current maneuver
 * list), RouteGuidanceManeuverUpdate (121: one maneuver by index) and LaneGuidance
 * (122), each for a display component, often field by field. Kept per component as in
 * DiPO. What it sends, as the build did:
 *   - the turn (updateTBTInfo: icon, distance in the phone's units), crossroad name and,
 *     when state is 6, the destination name
 *   - the HUD list (0xF2 frame: icon, next icon, road) and the HUD distance (2C)
 *   - remaining distance and arrival time (updateTBTSubInfo, in the owner's units)
 *   - up to 3 upcoming turns (updateTPTurnList, owner's units) and lanes (0xF1 frame)
 * Never the cluster's alive or operation status: phone guidance doesn't claim the
 * cluster (the cluster doesn't come back from that on these cars).
 * Also from the build: when the source app changes (Apple Maps to Waze, say), what the
 * old app left is cleared and route guidance restarted, so the phone resends all of it.
 * Not ported: DiPO's per-region icon filters (China, Europe, Middle East, Australia,
 * Brazil); on US and Canada cars the build sends every icon.
 * One thread: every call comes from the same handler.
 */
final class CpTurns {
    final Context context;
    final Cluster cluster;
    /** restarts the phone's route guidance updates (Stop, then Start) on a thread of its own */
    final Runnable restart;
    /** component id -> its route guidance state (DiPO e/u.Al) */
    final LinkedHashMap<Integer, Update> updates = new LinkedHashMap<Integer, Update>();
    /** component id -> maneuver index -> maneuver (DiPO e/u.Am) */
    final LinkedHashMap<Integer, LinkedHashMap<Integer, Maneuver>> maneuvers = new LinkedHashMap<Integer, LinkedHashMap<Integer, Maneuver>>();
    String source;
    /** last HUD list sent (type, next, road), so an unchanged one isn't resent */
    int hudType, hudNext;
    String hudRoad;
    /**
     * The last HUD list frame and when it went out. The HUD (a separate unit) can miss a frame or
     * lose its state while the cluster keeps working; on the car its arrow and road then froze while
     * the HUD distance (sent every push) kept counting down, until the route was restarted. So the
     * unchanged frame is resent every HUD_RESEND_MS from refresh(), independent of phone updates.
     */
    byte[] lastHud;
    long hudAt;
    static final long HUD_RESEND_MS = 2000L;
    /** the last lane log line, so an unchanged one isn't logged again */

    /** diagnostics: per kind, how many were seen and the last "change key" logged */
    private final java.util.HashMap<String, int[]> seenN = new java.util.HashMap<String, int[]>();
    private final java.util.HashMap<String, String> seenKey = new java.util.HashMap<String, String>();

    /** first 20 per kind, then every 10th, and always when the change key differs from the last one logged */
    private boolean sample(String kind, String changeKey) {
        int[] c = seenN.get(kind);
        if (c == null) seenN.put(kind, c = new int[1]);
        int n = ++c[0];
        boolean changed = changeKey != null && !changeKey.equals(seenKey.get(kind));
        if (changeKey != null) seenKey.put(kind, changeKey);
        return n <= 20 || n % 10 == 0 || changed;
    }

    private static String arr(int[] v) {
        return v == null ? "null" : java.util.Arrays.toString(v);
    }

    private static int len(String s) {
        return s == null ? -1 : s.length();
    }

    /** the component whose turn-by-turn is on the cluster (null: none), when it was last sent, and the last lane frame: refresh() resends them */
    Integer activeId;
    long lastSendAt;
    private byte[] lastLane;
    /** a phone turn is on the cluster (cleared by clusterIdle) */
    private boolean clusterTurn;
    private int refreshes;

    /**
     * Called about every second on the same thread: while guidance is active and the phone has
     * said nothing for a moment, the last known state goes out again (the car's own navigation
     * calls the cluster every 0.5-0.75 s), so the cluster and HUD don't age it out.
     */
    void refresh() {
        Dipo.flushObservations(false);
        Integer id = activeId;
        if (id == null) return;
        Update u = updates.get(id);
        if (u == null || u.state == 0) {
            clearGuidance();
            activeId = null;
            return;
        }
        long now = System.currentTimeMillis();
        byte[] hud = lastHud;
        if (hud != null && now - hudAt >= HUD_RESEND_MS) {
            if (sample("hud-resend", null)) d("HUD list resent unchanged (" + (now - hudAt) + " ms since the last one)");
            cluster.turnListNew(hud);
            hudAt = now;
        }
        if (now - lastSendAt < 900L) return;
        refreshes++;
        if (sample("refresh", null)) d("refresh without fresh phone data: last update " + (now - rgAt) + " ms ago, last send " + (now - lastSendAt) + " ms ago, refresh #" + refreshes);
        turn(id, u);
        if (lastLane != null) cluster.laneInfo(lastLane);
    }

    /** diagnostics: RouteGuidanceUpdates seen, and when the last one arrived (turn() runs only for these, there is no resend timer) */
    private int rgCount, firstTurnLogged;
    private long rgAt, firstRgAt;

    /** verbose diagnostics: only while the developer toggle is on (Dipo.dev) */
    private void d(String m) {
        if (Dipo.dev()) Dipo.log("TBT " + m);
    }

    /** one-line state worth keeping with the toggle off */
    private void essential(String m) {
        Dipo.log("TBT " + m);
    }

    CpTurns(Context context, Cluster cluster, Runnable restart) {
        this.context = context;
        this.cluster = cluster;
        this.restart = restart;
    }

    /** RouteGuidanceUpdate (DiPO e/u.c) */
    void routeGuidance(Iap2NotiMsg msg) {
        if (msg == null) return;
        rgCount++;
        rgAt = System.currentTimeMillis();
        if (rgCount == 1) {
            firstRgAt = rgAt;
            essential("first RouteGuidanceUpdate (120) received");
        }
        sourceCheck(msg);
        int[] ids = componentIds(msg);
        if (ids == null) {
            if (updates.isEmpty() && sample("rg-drop", null)) d("rg update dropped: message names no component and none is known yet");
            for (Integer id : updates.keySet()) {
                Update u = updates.get(id);
                if (u != null) u.read(id, msg);
                logUpdate("no ids, applied to known", id, u);
                turn(id, u);
            }
            return;
        }
        for (int k = 0; k < ids.length; k++) {
            Integer id = ids[k];
            Update u = updates.get(id);
            if (u != null) {
                u.read(id, msg);
            } else {
                u = new Update(id, msg);
                updates.put(id, u);
                if (id <= 0) d("rg update: component id " + id + " starts with nothing set (Update ctor skips read for id <= 0)");
            }
            logUpdate("ids=" + arr(ids), id, u);
            turn(id, u);
        }
    }

    private void logUpdate(String how, Integer id, Update u) {
        if (u == null) return;
        String key = id + "|" + u.state + "|" + u.maneuverState + "|" + arr(u.list);
        if (!sample("rg", key)) return;
        d("rg update comp=" + id + " (" + how + ") state=" + u.state + " maneuverState=" + u.maneuverState
                + " list=" + arr(u.list) + " count=" + u.count + " distNext=" + u.distNext + " nextStr='" + u.nextStr + "' nextUnits=" + u.nextUnits
                + " distLeft=" + u.distLeft + " distLeftStr='" + u.distLeftStr + "' distLeftUnits=" + u.distLeftUnits
                + " laneIndex=" + u.laneIndex + " laneCount=" + u.laneCount + " lanesShown=" + u.lanesShown + " visible=" + u.visible + " supports=" + u.supports
                + " roadLen=" + len(u.road) + " destLen=" + len(u.destination) + " sourceLen=" + len(u.sourceName) + " eta=" + u.eta + " timeLeft=" + u.timeLeft);
    }

    /** the components a RouteGuidanceUpdate is for (item 0); null if it doesn't say */
    static int[] componentIds(Iap2NotiMsg msg) {
        Iap2NotiMsg.Iap2ObjGroup g = msg.getItemGroup();
        if (g == null) return null;
        int[] ids = null;
        for (int k = 0; k < g.getItemCnt(); k++) {
            Iap2NotiMsg.Iap2ObjItem it = g.getObjItem(k);
            if (it == null) return null;
            if (it.getItemParamType() == 5 && it.getItemId() == 0 && it.getItemObjCount() > 0) ids = it.getItemIntArray();
        }
        return ids;
    }

    /**
     * RouteGuidanceManeuverUpdate (DiPO e/u.d): item 0 the components, item 1 the index.
     * Stored under the index the message carries (the build's fix, by Isaac Wisdom: stock
     * wrote the index into a copy and stored every maneuver under -1, so none was found).
     */
    void maneuver(Iap2NotiMsg msg) {
        if (msg == null) return;
        int index = -1;
        int[] ids = null;
        Iap2NotiMsg.Iap2ObjGroup g = msg.getItemGroup();
        if (g != null) {
            int[] found = null;
            boolean whole = true;
            for (int k = 0; k < g.getItemCnt(); k++) {
                Iap2NotiMsg.Iap2ObjItem it = g.getObjItem(k);
                if (it == null) {
                    whole = false;
                    break;
                }
                int id = it.getItemId();
                if (it.getItemObjCount() <= 0 || (id != 0 && id != 1)) continue;
                int[] v = it.getItemIntArray();
                if (v == null || v.length == 0) continue;
                if (id == 0) found = v;
                else index = v[0];
            }
            if (whole) ids = found;
        }
        if (index < 0) {
            if (sample("mn-drop", null)) d("maneuver dropped: no maneuver index in the message (ids=" + arr(ids) + ")");
            return;
        }
        if (ids == null && maneuvers.isEmpty() && sample("mn-drop2", null)) d("maneuver #" + index + " lost: names no component and no component is known yet");
        if (ids == null) {
            for (Integer id : maneuvers.keySet()) {
                LinkedHashMap<Integer, Maneuver> m = maneuvers.get(id);
                if (m == null) continue;
                Maneuver x = m.get(index);
                if (x != null) x.read(index, id, msg);
                else m.put(index, new Maneuver(index, id, msg));
                logManeuver("no ids, applied to known", id, m.get(index));
            }
            return;
        }
        for (int k = 0; k < ids.length; k++) {
            int id = ids[k];
            LinkedHashMap<Integer, Maneuver> m = maneuvers.get(id);
            if (m != null) {
                Maneuver x = m.get(index);
                if (x != null) x.read(index, id, msg);
                else m.put(index, new Maneuver(index, id, msg));
            } else {
                m = new LinkedHashMap<Integer, Maneuver>();
                m.put(index, new Maneuver(index, id, msg));
                maneuvers.put(id, m);
            }
            logManeuver("ids=" + arr(ids), id, m.get(index));
        }
    }

    private void logManeuver(String how, int id, Maneuver x) {
        if (x == null) return;
        String key = id + "|" + x.index + "|" + x.type + "|" + x.junction + "|" + x.exit;
        if (!sample("mn", key)) return;
        d("maneuver comp=" + id + " (" + how + ") index=" + x.index + " type=" + x.type + " junction=" + x.junction + " side=" + x.side
                + " exit=" + x.exit + " angles=" + arr(x.angles) + " distance=" + x.distance + " distUnits=" + x.distUnits + " distStr='" + x.distStr + "'"
                + " linkedLane=" + x.linkedLane + " descLen=" + len(x.description) + " afterRoadLen=" + len(x.afterRoad) + " stored=" + (maneuvers.get(id) == null ? 0 : maneuvers.get(id).size()));
    }

    /** Last 16 lane windows across components; 0x5204 normally precedes 0x5201. */
    final LinkedHashMap<Long, CpLaneDecoder.Info> laneInfos = new LinkedHashMap<Long, CpLaneDecoder.Info>();

    private static long laneKey(int component, int index) {
        return ((long) component << 32) | (index & 0xffffffffL);
    }

    void rawLanes(CpLaneDecoder.Info info) {
        long key = laneKey(info.component, info.index);
        laneInfos.remove(key);
        laneInfos.put(key, info);
        while (laneInfos.size() > 16) laneInfos.remove(laneInfos.keySet().iterator().next());
        d("decoded lanes " + info.summary());
        Update u = updates.get(info.component);
        if (activeId != null && activeId == info.component && u != null) {
            selectLanes(info.component, u);
            updateJunction(info.component, u);
        }
    }

    private void selectLanes(int component, Update u) {
        boolean showing = u.lanesShown && !(u.count == 0 && u.state <= 0) && u.state != 0;
        CpLaneDecoder.Info info = showing ? laneInfos.get(laneKey(component, u.laneIndex)) : null;
        if (sample("lane-match", component + "|" + u.laneIndex + "|" + showing + "|" + (info != null)))
            d("lane match comp=" + component + " index=" + u.laneIndex + " showing=" + showing + " found=" + (info != null));
        if (info == null) {
            if (lastLane != null) {
                byte[] blank = new byte[81]; blank[0] = (byte) 0xf1;
                cluster.laneInfo(blank);
                lastLane = null;
            }
            clearLaneDist();
            return;
        }
        byte[] f = new byte[81]; f[0] = (byte) 0xf1; f[1] = (byte) info.lanes.length;
        for (int k = 0; k < info.lanes.length; k++) {
            CpLaneDecoder.Lane l = info.lanes[k];
            int[] one = laneValues(l.status, l.angles, new int[] { l.highlight });
            f[3 + k] = (byte) one[0];
            for (int j = 0; j < 3; j++) f[19 + 3 * k + j] = (byte) one[1 + j];
        }
        StringBuilder hex = new StringBuilder();
        for (byte b : f) hex.append(Character.forDigit((b >> 4) & 15, 16)).append(Character.forDigit(b & 15, 16));
        String detail = "laneIndex=" + u.laneIndex + " laneCount=" + u.laneCount + " frame=" + hex;
        String observation = info.summary() + "|" + detail;
        if (!observation.equals(lastLaneObs)) {
            lastLaneObs = observation;
            // Observations fields are capped at 400 chars: one lane per key preserves all 16 angles.
            String prefix = "source=CarPlay comp=" + info.component + " index=" + info.index
                    + " descBytes=" + info.descriptionLength + " n=" + info.lanes.length;
            if (info.lanes.length == 0) Dipo.observe(true, prefix, detail, null);
            for (CpLaneDecoder.Lane lane : info.lanes) Dipo.observe(true, prefix + " lane=" + lane.index
                    + " status=" + lane.status + " angles=" + arr(lane.angles) + " h" + lane.highlight, detail, null);
        }
        if (!java.util.Arrays.equals(lastLane, f)) cluster.laneInfo(f);
        lastLane = f;
        if (info.lanes.length == 0) clearLaneDist();
    }

    /** LaneGuidance (the build's applyLanes): up to 8 lanes as the cluster's 0xF1 frame */
    void lanes(Iap2NotiMsg msg) {
        Iap2NotiMsg.Iap2ObjGroup g = msg == null ? null : msg.getItemGroup();
        if (g == null) {
            if (sample("ln-drop", null)) d("lanes dropped: message has no item group");
            return;
        }
        int[] status = new int[8], a = new int[8], b = new int[8], c = new int[8];
        int n = 0;
        Iap2NotiMsg.Iap2ObjGroup[] lanes = null;
        for (int k = 0; k < g.getItemCnt(); k++) {
            Iap2NotiMsg.Iap2ObjItem it = g.getObjItem(k);
            if (it != null && it.getItemParamType() == 13 && it.getItemId() == 2) lanes = it.getItemGroupArray();
        }
        if (lanes != null) {
            for (int k = 0; k < lanes.length && n < 8; k++) {
                int[] one = laneOne(lanes[k]);
                status[n] = one[0];
                a[n] = one[1];
                b[n] = one[2];
                c[n] = one[3];
                n++;
            }
        }
        byte[] f = new byte[81];
        f[0] = (byte) 0xF1;
        f[1] = (byte) n;
        for (int k = 0; k < n; k++) {
            f[k + 3] = (byte) status[k];
            f[k * 3 + 19] = (byte) a[k];
            f[k * 3 + 20] = (byte) b[k];
            f[k * 3 + 21] = (byte) c[k];
        }
        StringBuilder sb = new StringBuilder();
        for (int k = 0; k < n; k++) sb.append(k == 0 ? "" : " ").append(status[k]).append(':').append(a[k]).append('/').append(b[k]).append('/').append(c[k]);
        if (sample("ln", n + "|" + sb)) d("lanes phoneLanes=" + (lanes == null ? -1 : lanes.length) + " sent=" + n + " [" + sb + "]");
        lastLane = f.clone();
        observeLanes(lanes, n, sb.toString(), f);
        cluster.laneInfo(f);
    }

    /**
     * one lane: {status byte, up to 3 arrow icons}. The phone gives a lane a status (0 not good,
     * 1 good, 2 preferred), its arrow angles and the angle that leads along the route (highlight);
     * laneValues turns them into the cluster's per-arrow colours.
     */
    static int[] laneOne(Iap2NotiMsg.Iap2ObjGroup g) {
        int[] r = new int[4];
        r[0] = 1;
        if (g == null) return r;
        int[] angles = null, highlight = null;
        int status = -1;
        for (int k = 0; k < g.getItemCnt(); k++) {
            Iap2NotiMsg.Iap2ObjItem it = g.getObjItem(k);
            if (it == null) continue;
            int t = it.getItemParamType();
            if (t != 5 && t != 8) continue;
            int[] v = it.getItemIntArray();
            if (v == null || v.length == 0) continue;
            int id = it.getItemId();
            if (id == 1) {
                status = v[0];
            } else if (id == 2) {
                angles = v;
            } else if (id == 3) {
                highlight = v;
            }
        }
        return laneValues(status, angles, highlight);
    }

    /**
     * One lane as {status byte, up to 3 arrow image ids}. The status byte holds 2 bits per arrow
     * slot, slot 0 lowest: 00 not drawn, 01 normal (white), 10 recommended (blue), 11 inactive
     * (grey), car-verified 2026-11-05 (.agents/cluster-lane-arrows.md); the arrows are drawn
     * overlaid, so a lane with several directions needs the matching component glyphs
     * (LaneGlyphs), not the single ones.
     *
     * The colours mirror CarPlay per lane, from the lane status and the highlight angle (an arrow
     * "matches" when its angle equals a highlight angle; none valid, or none matching, means all
     * arrows match): status 0 grey on every arrow; status 1 white on the matching arrows and grey
     * on the others; status 2 blue on the matching arrows and grey on the others. Blue only ever
     * comes from the phone's status 2. A status that is not 0..2 counts as 1. A lane with no valid
     * angle sends the lane's value on slot 0 only.
     */
    static int[] laneValues(int status, int[] angles, int[] highlights) {
        // the lane's distinct direction classes (laneIcon values), in the phone's order, and which ones the route takes
        int[] cls = new int[8];
        int n = 0, onRoute = 0;
        if (angles != null) {
            for (int k = 0; k < angles.length; k++) {
                int a = angles[k];
                if (a < -180 || a > 180) continue;
                int c = laneIcon(a), i = 0;
                while (i < n && cls[i] != c) i++;
                if (i == n) cls[n++] = c;
                if (highlights != null) for (int h : highlights) if (h == a) onRoute |= 1 << i;
            }
        }
        return CpLaneFrame.lane(java.util.Arrays.copyOf(cls, n), onRoute, status);
    }

    /**
     * Image ids for the arrows of a multi-direction lane, car-verified 2026-11-05 and listed in
     * .agents/cluster-lane-arrows.md ("Car-verified glyphs and multi-arrow pairs"). Single
     * directions use the plain ids 1..8 (laneIcon values, which double as the direction classes
     * here). Each row is {direction classes in slot order, image ids in slot order}; the lane's set
     * of directions matches a row whatever order the phone lists its angles in, and slot k of the
     * status byte belongs to the k-th class of the row.
     */
    static final class LaneGlyphs {
        static final int ST = 1, SLR = 2, R = 3, SHR = 4, UT = 5, SHL = 6, L = 7, SLL = 8;
        static final int[][][] SETS = {
            { { UT, L }, { 10, 14 } },
            { { UT, SLL }, { 10, 15 } },
            { { ST, L }, { 9, 12 } },
            { { ST, SLL }, { 9, 13 } },
            { { ST, SHL }, { 9, 11 } },
            { { ST, UT }, { 9, 10 } },
            { { L, SLL }, { 12, 13 } },
            { { ST, R }, { 16, 18 } },
            { { ST, SLR }, { 16, 19 } },
            { { ST, SHR }, { 16, 17 } },
            { { R, SLR }, { 18, 21 } },
            { { L, R }, { 31, 32 } },
            { { SLL, SLR }, { 30, 33 } },
            { { UT, R }, { 26, 32 } },
            { { UT, SLR }, { 26, 33 } },
            { { L, ST, R }, { 28, 22, 24 } },
            { { SLL, ST, R }, { 30, 22, 24 } },
            { { L, ST, SLR }, { 28, 22, 33 } },
            { { SHL, ST, R }, { 27, 22, 24 } },
            { { L, ST, SHR }, { 28, 22, 25 } },
            { { SLL, ST, SLR }, { 30, 22, 33 } },
            { { L, SLL, ST }, { 12, 13, 9 } },
            { { ST, SLR, R }, { 16, 19, 18 } },
            { { UT, L, ST }, { 26, 31, 22 } },
            { { UT, ST, R }, { 26, 22, 24 } },
            { { UT, L, R }, { 26, 31, 32 } },
        };

        /** snap: slight and sharp turns count as the plain left / right */
        static int fold(int c, boolean snap) {
            if (!snap) return c;
            return c == SLR || c == SHR ? R : c == SLL || c == SHL ? L : c;
        }

        /** the row for the classes cls[0..n) (one class: the plain glyph), or null when none matches */
        static int[][] find(int[] cls, int n, boolean snap) {
            int mask = 0, count = 0, first = 0;
            for (int i = 0; i < n; i++) {
                int c = fold(cls[i], snap);
                if ((mask & (1 << c)) != 0) continue;
                mask |= 1 << c;
                if (count++ == 0) first = c;
            }
            if (count == 1) return new int[][] { { first }, { first } };
            for (int[][] row : SETS) {
                int m = 0;
                for (int c : row[0]) m |= 1 << c;
                if (m == mask) return row;
            }
            return null;
        }
    }

    /** a lane angle (degrees, right positive) as the cluster's arrow: 1 straight, 2-4 right, 5 back, 6-8 left */
    static int laneIcon(int a) {
        if (a > 180) a -= 360;
        else if (a < -180) a += 360;
        if (a >= 0) {
            if (a <= 22) return 1;
            if (a <= 67) return 2;
            if (a <= 112) return 3;
            return a <= 157 ? 4 : 5;
        }
        a = -a;
        if (a <= 22) return 1;
        if (a <= 67) return 8;
        if (a <= 112) return 7;
        return a <= 157 ? 6 : 5;
    }

    /** the iAP2 session ended (DiPO e/u.disconnected) */
    void disconnected() {
        Dipo.flushObservations(true);
        reset();
        hudBlank();
        clusterIdle();
        source = null;
    }

    /** route guidance stopped (DiPO e/u.nS: the car's navigation took turn-by-turn back, or state 0) */
    void stop() {
        guidanceStarted = false;
        laneInfos.clear();
        activeId = null;
        hudBlank();
        clusterIdle();
        Dipo.flushObservations(true);
    }

    /** forget every component's state and maneuvers (DiPO e/u.nT) */
    void reset() {
        clearGuidance();
        lastProjection = 0;
        guidanceStarted = false;
        laneInfos.clear();
        lastLane = null;
        activeId = null;
        for (LinkedHashMap<Integer, Maneuver> m : maneuvers.values()) {
            if (m != null) m.clear();
        }
        for (Update u : updates.values()) {
            if (u != null) u.clear();
        }
    }

    /** SourceName (item 19) changed: clear the old app's leftovers and have the phone resend */
    void sourceCheck(Iap2NotiMsg msg) {
        Iap2NotiMsg.Iap2ObjGroup g = msg.getItemGroup();
        if (g == null) return;
        for (int k = 0; k < g.getItemCnt(); k++) {
            Iap2NotiMsg.Iap2ObjItem it = g.getObjItem(k);
            if (it == null || it.getItemId() != 19 || it.getItemParamType() != 10 || it.getItemObjCount() <= 0) continue;
            String[] v = it.getItemStringArray();
            String s = v == null || v.length == 0 ? null : v[0];
            if (s == null || s.length() == 0) continue;
            String was = source;
            source = s;
            if (was == null || was.equals(s)) return;
            Dipo.log("CarPlay: route guidance source changed from " + was + " to " + s + ", clearing turn-by-turn");
            reset();
            hudBlank();
            if (restart != null) new Thread(restart, "hmgapi-cp-rg-restart").start();
            return;
        }
    }

    /** one component's update to the cluster (DiPO e/u.a(Integer, Object), with the build's changes) */
    void turn(Integer id, Update u) {
        if (id < 0 || u == null) {
            if (sample("tn-drop", null)) d("turn skipped: comp=" + id + " update=" + (u == null ? "null" : "yes"));
            return;
        }
        if (u.state == 0) {
            if (sample("tn-state0", null)) d("turn: comp=" + id + " state 0, HUD cleared");
            stop();
            return;
        }
        activeId = id;
        if (!guidanceStarted) {
            // a junction picture stock navigation left before the phone took over must not persist
            guidanceStarted = true;
            cluster.junctionView(65535, 65535, 65535);
        }
        selectLanes(id, u);
        lastSendAt = System.currentTimeMillis();
        if (u.state == 3 || u.state == 5) {
            clearGuidance();
            if (lastHud != null) hudBlank();
            cluster.tbtInfo(u.state == 3 ? 9 : 10, 0, 0f, 0f, 0, 0, 0, 0, 0);
            clusterTurn = true;
            return;
        }
        int[] list = u.list == null || u.list.length == 0 ? null : u.list.clone();
        float dist = 0f;
        if (u.nextStr != null && !u.nextStr.equals("")) {
            try {
                dist = Float.parseFloat(u.nextStr.replace(',', '.'));
                if (Float.isNaN(dist) || Float.isInfinite(dist)) dist = 0f;
            } catch (NumberFormatException e) {
                dist = 0f;
            }
        }
        if (u.state == 6) cluster.destinationName(0, u.destination);
        int unit;
        switch (u.nextUnits) {
            case 0: unit = Cluster.UNIT_KM; break;
            case 1: unit = Cluster.UNIT_MI; break;
            case 3: unit = Cluster.UNIT_YD; break;
            case 4: unit = Cluster.UNIT_FT; break;
            default: unit = Cluster.UNIT_M; break;
        }
        LinkedHashMap<Integer, Maneuver> m = maneuvers.get(id);
        Maneuver x = m == null || list == null ? null : m.get(list[0]);
        if (x == null) {
            boolean wasApproaching = approachComponent != null;
            clearGuidance();
            // Leave the AR view mid-route with the projection icon; the idle compass is only for stop/disconnect.
            if (wasApproaching && lastProjection != 0) {
                cluster.tbtInfo(lastProjection, 0, 0f, dist, 0, 0, unit, 0, 0);
                clusterTurn = true;
            }
            // the maneuver isn't here (yet): what is known still goes out, and the phone is asked to resend
            if (sample("tn-drop2", u.state + "|" + (m == null) + "|" + (list == null) + "|" + (list == null ? -1 : list[0]))) d("turn without maneuver: comp=" + id + " state=" + u.state + " maneuvers=" + (m == null ? "none" : String.valueOf(m.size())) + " list=" + arr(list) + " (known comps=" + maneuvers.keySet() + ")");
            sendHudDist(dist, unit);
            sendLaneDist(dist, unit);
            sendTrip(u);
            askResend("maneuver " + (list == null ? "list" : String.valueOf(list[0])) + " missing");
            return;
        }
        int icon = icon(x.type, x.side, x.junction, x.exit, u.state);
        String kind = matchKind(x.type, x.side, x.junction, x.exit, u.state);
        if (icon == 0) {
            icon = fallbackIcon(x.type, x.side, x.junction, x.exit);
            noteUnmapped(x, icon);
        }
        observeIcon(x, u.state, icon, kind);
        cluster.crossroadName(x.afterRoad);
        if (firstTurnLogged == 0) {
            firstTurnLogged = 1;
            essential("first turn() push: rg#" + rgCount + ", " + (System.currentTimeMillis() - firstRgAt) + " ms after the first RouteGuidanceUpdate");
        }
        if (sample("tn", id + "|" + icon + "|" + u.state + "|" + list[0])) d("turn comp=" + id + " state=" + u.state + " index=" + list[0] + " type=" + x.type + " side=" + x.side + " junction=" + x.junction + " exit=" + x.exit + " -> icon " + icon + " dist=" + dist + " unit=" + unit);
        lastProjection = icon;
        CpLaneDecoder.Info shownLanes = u.lanesShown ? laneInfos.get(laneKey(id, u.laneIndex)) : null;
        int[] stock = u.state == 2 ? CpGuidance.ARRIVED.clone()
                : CpGuidance.approach(u, x) ? CpGuidance.stock(x, shownLanes) : null;
        if (stock == null || u.state == 2) clearApproach();
        else {
            if (approachComponent != null && (!approachComponent.equals(id) || approachIndex != x.index)) clearApproach();
            approachComponent = id;
            approachIndex = x.index;
            Dipo.approach(true, CpGuidance.bar(u.distNext, CpGuidance.window(x.type)));
        }
        cluster.tbtInfo(stock == null ? icon : stock[0], 0, stock == null ? 0f : stock[1], dist, 0, 0, unit, 0, 0);
        clusterTurn = true;
        updateJunction(id, u);
        sendHud(icon, id, u);
        sendHudDist(dist, unit);
        sendLaneDist(dist, unit);
        sendTrip(u);
        sendAhead(id, u);
    }

    /** a guidance session has sent its initial junction clear */
    private boolean guidanceStarted;
    /** projection icon of the last turn sent, resent when the AR window closes without a maneuver */
    private int lastProjection;
    private Integer approachComponent;
    private int approachIndex;

    private Integer junctionComponent;
    private int junctionIndex;
    private int[] junction;

    private void updateJunction(int component, Update u) {
        LinkedHashMap<Integer, Maneuver> known = maneuvers.get(component);
        int[] list = u.list;
        Maneuver current = known == null || list == null || list.length == 0 ? null : known.get(list[0]);
        if (!CpGuidance.approach(u, current)) { clearJunction(); return; }
        // At the maneuver point the phone may already link the next maneuver's lanes while the
        // list still names this one: keep what is shown until the list moves on.
        if (u.distNext == 0 && junctionComponent != null && junctionComponent == component
                && junctionIndex == current.index) return;
        Maneuver next = list.length > 1 ? known.get(list[1]) : null;
        CpLaneDecoder.Info lanes = u.lanesShown ? laneInfos.get(laneKey(component, u.laneIndex)) : null;
        int[] selected = CpJunctions.select(current, next, lanes);
        if (selected == null) { clearJunction(); return; }
        // The phone re-indexes the same maneuver on the way; the same picture stays up.
        if (junctionComponent != null && (junctionComponent != component || junctionIndex != current.index)
                && !java.util.Arrays.equals(junction, selected)) clearJunction();
        if (!java.util.Arrays.equals(junction, selected)) cluster.junctionView(selected[0], selected[1], selected[2]);
        junction = selected;
        junctionComponent = component;
        junctionIndex = current.index;
    }

    private void clearJunction() {
        if (junction == null) return;
        junction = null;
        junctionComponent = null;
        cluster.junctionView(65535, 65535, 65535);
    }

    private void clearGuidance() {
        clearApproach();
        clearJunction();
    }

    private void clearApproach() {
        if (approachComponent == null) return;
        approachComponent = null;
        Dipo.approach(false, 0);
    }

    private long resendAt;
    private final java.util.HashSet<String> unmapped = new java.util.HashSet<String>();

    /** have the phone resend its guidance (Stop, then Start), at most once in 30 s */
    private void askResend(String why) {
        long now = System.currentTimeMillis();
        if (restart == null || now - resendAt < 30000L) return;
        resendAt = now;
        Dipo.log("CarPlay: asking the phone to resend route guidance (" + why + ")");
        new Thread(restart, "hmgapi-cp-rg-restart").start();
    }

    /** an icon the exact tables lack: logged once per combination (up to 40), always */
    private void noteUnmapped(Maneuver x, int icon) {
        String k = x.type + "/" + x.side + "/" + x.junction + "/" + x.exit;
        if (unmapped.size() < 40 && unmapped.add(k)) Dipo.log("CarPlay: no exact icon for maneuver type " + x.type + " side " + x.side + " junction " + x.junction + " exit " + x.exit + ", using " + icon);
    }

    private String lastIconObs, lastLaneObs;

    /** how an icon was found: exact table, angle band (types 1/2/47-50), angle (any type), semantic (type only), blank */
    static String matchKind(int type, int side, int junction, int exit, int state) {
        if (exactIcon(type, side, junction, exit, state) != 0) return "exact";
        if (bandedTurn(type, junction, exit) != 0) return "band";
        if (fallbackIcon(type, side, junction, exit) == NO_ICON) return "blank";
        return exit != 0 ? "angle" : "semantic";
    }

    /** an exit angle rounded to the nearest 15 degrees (the record's key; the exact angle goes in the detail) */
    static int exitBucket(int exit) {
        return Math.round(exit / 15f) * 15;
    }

    /**
     * The local mapping record (runtime dir, tbt-icons.*): one sighting per change of maneuver
     * presentation, with the phone's instruction text and the road after it, so the table can be
     * built from drives (the iAP2 maneuver list isn't public).
     */
    private void observeIcon(Maneuver x, int state, int icon, String kind) {
        String key = "type=" + x.type + " junction=" + x.junction + " side=" + x.side + " exit~" + exitBucket(x.exit) + (x.type == 12 ? " state=" + state : "");
        String detail = "icon=" + icon + " kind=" + kind + " exit=" + x.exit;
        String text = x.description == null ? "" : x.description;
        if (x.afterRoad != null && x.afterRoad.length() > 0) text = text + " -> " + x.afterRoad;
        String both = key + "|" + detail + "|" + text;
        if (both.equals(lastIconObs)) return;
        lastIconObs = both;
        Dipo.observe(false, key, detail, text);
    }

    private void observeLanes(Iap2NotiMsg.Iap2ObjGroup[] lanes, int n, String marks, byte[] frame) {
        StringBuilder key = new StringBuilder("n=" + (lanes == null ? 0 : lanes.length));
        for (int k = 0; lanes != null && k < lanes.length && k < 8; k++) {
            Iap2NotiMsg.Iap2ObjGroup g = lanes[k];
            int status = -1;
            int[] angles = null, highlight = null;
            for (int j = 0; g != null && j < g.getItemCnt(); j++) {
                Iap2NotiMsg.Iap2ObjItem it = g.getObjItem(j);
                if (it == null || (it.getItemParamType() != 5 && it.getItemParamType() != 8)) continue;
                int[] v = it.getItemIntArray();
                if (v == null || v.length == 0) continue;
                if (it.getItemId() == 1) status = v[0];
                else if (it.getItemId() == 2) angles = v;
                else if (it.getItemId() == 3) highlight = v;
            }
            key.append(" [s").append(status).append(" a").append(arr(angles)).append(" h").append(arr(highlight)).append(']');
        }
        Update u = activeId == null ? null : updates.get(activeId);
        StringBuilder hex = new StringBuilder();
        for (int k = 0; k < frame.length; k++) hex.append(Character.forDigit((frame[k] >> 4) & 15, 16)).append(Character.forDigit(frame[k] & 15, 16));
        String detail = "sent=" + n + " marks=" + marks + " frame=" + hex + (u == null ? "" : " laneIndex=" + u.laneIndex + " laneCount=" + u.laneCount + " distNext=" + u.distNext + " nextStr=" + u.nextStr);
        String both = key + "|" + detail;
        if (both.equals(lastLaneObs)) return;
        lastLaneObs = both;
        Dipo.observe(true, key.toString(), detail, null);
    }

    /**
     * The cluster's "no turn icon" for an unmappable maneuver: distances, lanes and trip still go out.
     * Firmware (Gen5W libExSLNavi RGIconIDToClusterDispType) falls back to 8, not the legacy Gen3
     * default 64 — and 64 rendered as a spinning "loading" glyph on this car. 8 is below the HUD
     * list gate (>=64) so no bogus arrow enters the HUD. See .agents/cluster-tbt-icons.md.
     * (Firmware-indicated; confirm the exact glyph on the car.)
     */
    static final int NO_ICON = 8;

    /**
     * An icon for a maneuver the exact tables don't list, so the stream goes on. A misleading
     * arrow is worse than none, so: with an exit angle, the nearest direction arrow (any type);
     * a type with a clear meaning but no angle, its own icon; else NO_ICON (never "straight"
     * for a turn).
     */
    static int fallbackIcon(int type, int side, int junction, int exit) {
        int a = bandedTurn(type, junction, exit);
        if (a != 0) return a;
        if (exit != 0) {
            if (junction != 0) return roundaboutIcon(side, exit);
            boolean left;
            switch (type) {
                case 1: case 47: case 49: case 13: left = true; break;
                case 2: case 48: case 50: case 14: left = false; break;
                default: left = exit < 0; break;
            }
            int deg = Math.abs(exit);
            if (deg > 180) deg = 360 - deg;
            if (deg >= 157) return side == 0 ? 72 : 73;
            if (deg <= 22 && type != 1 && type != 2) return 65;
            int sharpness = deg <= 67 ? 0 : deg <= 112 ? 1 : 2;
            return left ? 71 - sharpness : 66 + sharpness;
        }
        switch (type) {
            // no exit angle (Apple Maps in Korea sends none): the turn type alone says the direction
            case 1: return 70;    // left turn
            case 2: return 67;    // right turn
            case 47: return 69;   // sharp left
            case 48: return 68;   // sharp right
            case 49: return 71;   // slight left
            case 50: return 66;   // slight right
            case 13: return 71;   // keep left
            case 14: return 66;   // keep right
            case 3: return 65;
            case 4: case 18: return side == 0 ? 72 : 73;
            case 5: case 9: return 172;
            case 6: return side == 0 ? 96 : 97;   // enter a roundabout
            case 10: case 12: return 112;
            case 15: return 176;
            default: return NO_ICON;
        }
    }

    /** the roundabout icon with the nearest exit angle (the ones the exact tables use) */
    static int roundaboutIcon(int side, int exit) {
        int[] angle = { -180, -135, -120, -90, -45, -30, 0, 90, 120, 135, 180 };
        int[] icon = { 102, 104, 104, 105, 104, 107, side == 0 ? 96 : 97, 99, 100, 100, 102 };
        int e = exit;
        if (e > 180) e -= 360;
        else if (e < -180) e += 360;
        int best = 0;
        for (int k = 1; k < angle.length; k++) {
            if (Math.abs(angle[k] - e) < Math.abs(angle[best] - e)) best = k;
        }
        return icon[best];
    }

    /**
     * The cluster icon for a maneuver: iAP2 ManeuverType, driving side (0 right-hand
     * traffic, 1 left), junction type (0 intersection, 1 roundabout) and exit angle, as
     * the turn-by-turn build maps them (0: nothing to show).
     */
    static int icon(int type, int side, int junction, int exit, int state) {
        int i = exactIcon(type, side, junction, exit, state);
        return i != 0 ? i : bandedTurn(type, junction, exit);
    }

    /**
     * A plain intersection turn at an angle the exact table doesn't list (75 degrees, 30,
     * left-hand traffic ...): the nearest of the three basic arrows, so the cluster isn't
     * left without a turn. Slight up to 67 degrees, turn up to 112, sharp past that (the
     * same bands as the lane arrows); a type that says sharp or slight keeps that. No
     * angle (0) or a roundabout: nothing, as before.
     */
    static int bandedTurn(int type, int junction, int exit) {
        if (junction != 0 || exit == 0) return 0;
        boolean left;
        switch (type) {
            case 1: case 47: case 49: left = true; break;
            case 2: case 48: case 50: left = false; break;
            default: return 0;
        }
        int a = Math.abs(exit);
        if (a > 180) a = 360 - a;
        int sharpness = type == 47 || type == 48 ? 2 : type == 49 || type == 50 ? 0 : a <= 67 ? 0 : a <= 112 ? 1 : 2;
        // slight 66/71, turn 67/70, sharp 68/69 (right/left)
        return left ? 71 - sharpness : 66 + sharpness;
    }

    private static int exactIcon(int type, int side, int junction, int exit, int state) {
        switch (type) {
            case 1:   // left turn
                if (junction == 0 && exit == -120) return 69;
                if (side == 0 && junction == 0 && exit == -90) return 70;
                if (junction == 0 && exit == -60) return 71;
                if (junction == 0 && exit == -45) return 145;
                if (side == 1 && junction == 1 && exit == -120) return 104;
                if (side == 1 && junction == 1 && exit == -90) return 105;
                if (side == 1 && junction == 1 && exit == -30) return 107;
                return 0;
            case 2:   // right turn
                if (junction == 0 && exit == 60) return 66;
                if (side == 0 && junction == 0 && exit == 90) return 67;
                if (junction == 0 && exit == 120) return 68;
                if (side == 0 && junction == 1 && exit == 0) return 96;
                if (side == 1 && junction == 1 && exit == 0) return 97;
                if (side == 1 && junction == 1 && exit == 90) return 99;
                if (side == 1 && junction == 1 && exit == 120) return 100;
                if (side == 1 && junction == 1 && exit == 180) return 102;
                if (side == 0 && junction == 0 && exit == 45) return 144;
                return 0;
            case 3:   // straight
                return side == 0 && junction == 0 && exit == 0 ? 65 : 0;
            case 4:   // U-turn
                if (side == 0 && junction == 0) return 72;
                if (side == 1 && junction == 0) return 73;
                return 0;
            case 5:
            case 9:
                return side == 0 && junction == 0 && exit == 0 ? 172 : 0;
            case 12: {   // arrive; state 2 (arrived): 3
                int i = side == 0 && junction == 0 ? 112 : 0;
                return state == 2 ? 3 : i;
            }
            case 15: return side == 0 && junction == 0 && exit == 0 ? 176 : 0;
            case 19: return side == 0 && junction == 1 && exit == -180 ? 102 : 0;
            case 22: return side == 0 && junction == 0 && exit == 0 ? 82 : 0;
            case 23: return side == 0 && junction == 0 && exit == 0 ? 81 : 0;
            case 24: return side == 0 && junction == 0 && exit == 0 ? 114 : 0;
            case 25: return side == 0 && junction == 0 && exit == 0 ? 113 : 0;
            case 28: return side == 0 && junction == 1 && exit == 135 ? 100 : 0;
            case 29: return side == 0 && junction == 1 && exit == 90 ? 99 : 0;
            case 31:
                if (side == 0 && junction == 1 && exit == 0) return 97;
                if (side == 1 && junction == 1 && exit == 0) return 96;
                return 0;
            case 32: return side == 0 && junction == 1 && exit == -45 ? 104 : 0;
            case 33: return side == 0 && junction == 1 && exit == -90 ? 105 : 0;
            case 34: return side == 0 && junction == 1 && exit == -135 ? 104 : 0;
            case 35: return side == 0 && junction == 1 && exit == -180 ? 102 : 0;
            case 47:
                if (junction == 0 && exit <= -135 && exit >= -150) return 69;
                if (junction == 0 && exit == -30) return 71;
                return 0;
            case 48:
                if (junction == 0 && exit == 30) return 66;
                if (junction == 0 && exit >= 135 && exit <= 150) return 68;
                return 0;
            case 49: return junction == 0 && exit == -45 ? 71 : 0;
            case 50: return junction == 0 && exit == 45 ? 66 : 0;
            case 52: return side == 0 && junction == 0 && exit == 0 ? 174 : 0;
            case 53: return side == 0 && junction == 0 && exit == 0 ? 173 : 0;
            default: return 0;
        }
    }

    /** an upcoming turn's small icon (HUD list and turn list): 64 none, 65 straight, 66-68 right, 69-71 left, 72/73 U-turn */
    static int aheadIcon(int type, int side, int junction, int exit) {
        if (type == 1) {
            if (exit == -120 && junction == 0) return 69;
            if (exit == -90 && side == 0 && junction == 0) return 70;
            if (exit == -60 && junction == 0) return 71;
            return 70;
        }
        if (type == 2) {
            if (exit == 60 && junction == 0) return 66;
            if (exit == 90 && side == 0 && junction == 0) return 67;
            if (exit == 120 && junction == 0) return 68;
            return 67;
        }
        if (type == 3) return 65;
        if (type == 4) return side == 0 ? 72 : 73;
        if (type == 47) return 69;   // sharp left
        if (type == 48) return 68;   // sharp right
        if (type == 49) return 71;   // slight left
        if (type == 50) return 66;   // slight right
        return 64;
    }

    /** the HUD's list frame (0xF2): count, this icon, the next turn's icon, 0, road after this turn (UTF-16LE) */
    void sendHud(int type, Integer id, Update u) {
        if (type == NO_ICON) {
            // no arrow for this maneuver (car-verified 2026-11-05): the empty list blanks the HUD TBT, so
            // the previous turn's arrow doesn't stay up and isn't resent; the next mapped turn goes out again
            if (lastHud != null && lastHud.length == 1) return;
            byte[] empty = { (byte) 0xF2 };
            cluster.turnListNew(empty);
            lastHud = empty;
            hudAt = System.currentTimeMillis();
            hudType = -1;
            hudNext = 0;
            hudRoad = null;
            return;
        }
        if (type < 64) return;
        int next = 0;
        String road = "";
        LinkedHashMap<Integer, Maneuver> m = maneuvers.get(id);
        int[] list = u == null ? null : u.list;
        if (m != null && list != null && list.length > 0) {
            Maneuver x = m.get(list[0]);
            if (x != null && x.afterRoad != null) road = x.afterRoad;
            if (list.length > 1) {
                Maneuver y = m.get(list[1]);
                if (y != null && y.distance > 0) next = aheadIcon(y.type, y.side, y.junction, y.exit);
            }
        }
        if (hudType == type && hudNext == next && hudRoad != null && hudRoad.equals(road)) return;
        byte[] r;
        try {
            r = road.getBytes("UTF-16LE");
        } catch (java.io.UnsupportedEncodingException e) {
            return;
        }
        int n = Math.min(r.length, 78);
        byte[] f = new byte[n + 5];
        f[0] = (byte) 0xF2;
        f[1] = (byte) (next != 0 ? 2 : 1);
        f[2] = (byte) type;
        f[3] = (byte) next;
        System.arraycopy(r, 0, f, 5, n);
        Dipo.log("CarPlay: hud list type " + type + " next " + next);
        cluster.turnListNew(f);
        lastHud = f;
        hudAt = System.currentTimeMillis();
        hudType = type;
        hudNext = next;
        hudRoad = road;
    }

    /** the HUD's distance (updateTBTSubInfo2C: unit, tenths for km/mi, whole up to 4095) */
    void sendHudDist(float f, int unit) {
        if (f < 0f || unit < 0 || unit > 4) return;
        int whole = (int) f;
        int tenths = 0;
        if (unit == Cluster.UNIT_KM || unit == Cluster.UNIT_MI) {
            int t = (int) (f * 10f + 0.5f);   // to the nearest tenth: 0.96 is 1.0, not 0.9
            whole = t / 10;
            tenths = t % 10;
        }
        if (whole > 4095) {
            whole = 4095;
            tenths = 0;
        }
        cluster.tbtSubInfo2C(unit, tenths, whole, 0, 0, 0, 0, 0, 0);
    }

    /** the lane distance last sent (whole, unit, tenths) and when; null while none shows */
    private int[] laneDist;
    long laneDistAt;
    static final long LANE_DIST_RESEND_MS = 2000L;

    /**
     * The distance to the next maneuver in the box beside the lane strip (updateRemainDis), the
     * same distance and unit as the turn, while a lane frame with lanes shows (car-verified
     * 2026-11-05, .agents/cluster-lane-frame.md 1b). Sent on change and every LANE_DIST_RESEND_MS.
     * Only m, km and mi are verified: feet and yards go out as metres. The toll-gate flag stays 0.
     */
    void sendLaneDist(float f, int unit) {
        if (lastLane == null || lastLane[1] <= 0) {
            clearLaneDist();
            return;
        }
        if (f < 0f || unit < 0 || unit > 4) return;
        if (unit == Cluster.UNIT_FT) {
            f *= 0.3048f;
            unit = Cluster.UNIT_M;
        } else if (unit == Cluster.UNIT_YD) {
            f *= 0.9144f;
            unit = Cluster.UNIT_M;
        }
        int whole = (int) (f + 0.5f), tenths = 0;
        if (unit == Cluster.UNIT_KM || unit == Cluster.UNIT_MI) {
            int t = (int) (f * 10f + 0.5f);
            whole = t / 10;
            tenths = t % 10;
        }
        if (whole > 65534) {
            whole = 65534;
            tenths = 0;
        }
        int[] v = { whole, unit, tenths };
        long now = System.currentTimeMillis();
        if (laneDist != null && java.util.Arrays.equals(laneDist, v) && now - laneDistAt < LANE_DIST_RESEND_MS) return;
        laneDist = v;
        laneDistAt = now;
        cluster.remainDis(whole, unit, tenths, 0);
    }

    /** lanes gone: the lane distance box back to the invalid pattern the stock navigation uses */
    private void clearLaneDist() {
        if (laneDist == null) return;
        laneDist = null;
        cluster.remainDis(65535, 15, 15, 0);
    }

    /**
     * Guidance over: the cluster's turn back to the stock idle compass (NO_ROUTE_GUIDE 8; 0 draws a
     * spinning loading icon on NEEV KOR) and the trip distance/arrival invalid. The car navigation
     * is no longer skipped then, but it only sends on change, so without this the last phone turn
     * stays on the cluster while parked (car-verified 2026-11-07). Only after a phone turn was sent,
     * so an idle stock compass keeps its heading.
     */
    void clusterIdle() {
        if (!clusterTurn) return;
        clusterTurn = false;
        cluster.tbtInfo(8, 0, 0f, 0f, -1, 0, 0, 0, -1);
        cluster.tbtSubInfo(0f, -1, 0, 0, 0, 0, 0, 0f, -1, 0);
    }

    /** HUD list and extras cleared (the build's sendHudBlank) */
    void hudBlank() {
        clearGuidance();
        lastLane = null;
        clearLaneDist();
        cluster.tbtSubInfo2C(0, 0, 0, 0, 0, 0, 0, 0, 0);
        byte[] lanes = new byte[81];
        lanes[0] = (byte) 0xF1;
        cluster.laneInfo(lanes);
        hudType = -1;
        hudNext = 0;
        hudRoad = null;
        lastHud = null;
        byte[] empty = { (byte) 0xF2 };
        cluster.turnListNew(empty);
        cluster.turnListNew(empty);
    }

    /**
     * Remaining distance and arrival time (updateTBTSubInfo). Distance in the owner's
     * units (Settings), else the phone's. Arrival: a clock time (seconds since 2001 or
     * 1970) or, failing that, now + the time remaining (up to a week).
     */
    void sendTrip(Update u) {
        int d = u.distLeft, units = u.distLeftUnits;
        if (sample("trip", d + "|" + units)) d("trip source: rg#" + rgCount + " ageMs=" + (System.currentTimeMillis() - rgAt) + " distLeft=" + u.distLeft + " phoneUnits=" + u.distLeftUnits + " distLeftStr='" + u.distLeftStr + "' ownerUnit=" + Car.distanceUnit(context) + " eta=" + u.eta + " timeLeft=" + u.timeLeft);
        int whole = 0, tenths = 0, unit = Cluster.UNIT_M;
        if (d > 0) {
            whole = d;
            int owner = Car.distanceUnit(context);
            if (owner == Car.DISTANCE_KM) units = d < 1000 ? 2 : 0;
            else if (owner == Car.DISTANCE_MILES) units = d < 161 ? 4 : 1;
            switch (units) {
                case 0:
                    whole = d / 1000;
                    tenths = (d % 1000) / 100;
                    unit = Cluster.UNIT_KM;
                    break;
                case 1: {
                    int t = d * 10 / 1609;
                    tenths = t % 10;
                    whole = t / 10;
                    unit = Cluster.UNIT_MI;
                    break;
                }
                case 2:
                    break;
                case 3:
                    whole = d * 1094 / 1000;
                    unit = Cluster.UNIT_YD;
                    break;
                case 4:
                    whole = d * 3281 / 1000;
                    unit = Cluster.UNIT_FT;
                    break;
                default:
                    if (d >= 1000) {
                        whole = d / 1000;
                        tenths = (d % 1000) / 100;
                        unit = Cluster.UNIT_KM;
                    }
                    break;
            }
        }
        int hour = -1, minute = -1, timeType = -1, timeFormat;
        Calendar cal = null;
        long eta = u.eta;
        if (eta < 500000000L) {
            long left = u.timeLeft;
            if (left > 0 && left <= 604800L) {
                cal = Calendar.getInstance();
                cal.add(Calendar.SECOND, (int) left);
            }
        } else {
            if (eta < 1500000000L) eta += 978307200L;   // Apple's 2001 epoch
            cal = Calendar.getInstance();
            cal.setTimeInMillis(eta * 1000L);
        }
        if (cal != null) {
            hour = cal.get(Calendar.HOUR_OF_DAY);
            minute = cal.get(Calendar.MINUTE);
            timeType = 1;
            timeFormat = context == null || DateFormat.is24HourFormat(context) ? 2 : 1;
        } else {
            timeFormat = -1;
        }
        if (d <= 0 && timeType < 0) return;
        if (sample("trip-out", whole + "|" + tenths + "|" + unit)) d("trip sent: rg#" + rgCount + " ageMs=" + (System.currentTimeMillis() - rgAt) + " whole=" + whole + " tenths=" + tenths + " unit=" + unit + " (tbtSubInfo = REMAINING TRIP distance, not next-turn distance)");
        cluster.tbtSubInfo(whole + tenths / 10f, d > 0 ? 0 : -1, unit, hour, minute, timeType, timeType < 0 ? -1 : timeFormat, 0f, -1, 0);
    }

    /** up to 3 upcoming turns after this one (updateTPTurnList), distances in the owner's units */
    void sendAhead(Integer id, Update u) {
        int[] list = u == null ? null : u.list;
        if (id == null || list == null || list.length <= 1) return;
        LinkedHashMap<Integer, Maneuver> m = maneuvers.get(id);
        if (m == null) return;
        int count = 0;
        for (int k = 1; k < list.length && count < 3; k++) {
            Maneuver x = m.get(list[k]);
            if (x != null && x.distance > 0) count++;
        }
        if (count == 0) return;
        int owner = Car.distanceUnit(context);
        Cluster.Turn[] turns = new Cluster.Turn[count];
        int n = 0;
        for (int k = 1; k < list.length && n < 3; k++) {
            Maneuver x = m.get(list[k]);
            if (x == null || x.distance <= 0 || n >= count) continue;
            Cluster.Turn t = new Cluster.Turn();
            t.type = aheadIcon(x.type, x.side, x.junction, x.exit);
            t.direction = 0;
            t.traffic = 0;
            t.no = n + 1;
            t.name = x.afterRoad == null ? "" : x.afterRoad;
            t.exitNumber = "";
            int d = x.distance;
            float f = d;
            int unit = Cluster.UNIT_M;
            if (owner == Car.DISTANCE_KM) {
                if (d >= 1000) {
                    unit = Cluster.UNIT_KM;
                    f = d / 1000f;
                }
            } else if (owner == Car.DISTANCE_MILES) {
                if (d < 161) {
                    unit = Cluster.UNIT_FT;
                    f = d * 3.28084f;
                } else {
                    unit = Cluster.UNIT_MI;
                    f = d / 1609f;
                }
            }
            if (f < 0f) f = 0f;
            if (f > 65535f) f = 65535f;
            t.distance = f;
            t.unit = unit;
            turns[n++] = t;
        }
        if (n > 0) cluster.turnList(turns);
    }

    /** one display component's route guidance state (DiPO e/c) */
    static final class Update {
        int state, maneuverState, distLeft, distLeftUnits, distNext, nextUnits, count, laneIndex, laneCount;
        String road, destination, distLeftStr, nextStr, sourceName;
        long eta, timeLeft;
        int[] list;
        boolean visible, lanesShown, supports, hasDistance;

        /** as DiPO: a component id of 0 or less starts with nothing set (not even the defaults) */
        Update(int id, Iap2NotiMsg msg) {
            if (msg == null || id <= 0) return;
            clear();
            read(id, msg);
        }

        void clear() {
            state = 0;
            maneuverState = 1;
            road = "";
            destination = "";
            eta = 0;
            timeLeft = 0;
            distLeft = 0;
            distLeftStr = "";
            distLeftUnits = 0;
            distNext = 0;
            hasDistance = false;
            nextStr = "";
            nextUnits = 0;
            list = null;
            count = 0;
            visible = false;
            laneIndex = 0;
            laneCount = 0;
            lanesShown = false;
            sourceName = "";
            supports = false;
        }

        /** the fields this message carries (by iAP2 type: 1/5 uint8/16, 2/6 uint32, 3/7 uint64, 8 enum, 9 bool, 10 string) */
        void read(int id, Iap2NotiMsg msg) {
            Iap2NotiMsg.Iap2ObjGroup g = msg == null ? null : msg.getItemGroup();
            if (g == null) return;
            int oldFirst = list == null || list.length == 0 ? -1 : list[0];
            boolean freshDistance = false;
            for (int k = 0; k < g.getItemCnt(); k++) {
                Iap2NotiMsg.Iap2ObjItem it = g.getObjItem(k);
                if (it == null) continue;
                int item = it.getItemId(), n = it.getItemObjCount();
                switch (it.getItemParamType()) {
                    case 1:
                    case 5: {
                        int[] v = n > 0 ? it.getItemIntArray() : null;
                        if (v != null && v.length == 0) v = null;
                        switch (item) {
                            case 13:
                                if (v != null) {
                                    n = Math.min(n, v.length);
                                    list = new int[n];
                                    for (int j = 0; j < n; j++) list[j] = v[j];
                                } else {
                                    list = null;
                                }
                                break;
                            case 14: count = v != null ? v[0] : 0; break;
                            case 16: laneIndex = v != null ? v[0] : 0; break;
                            case 17: laneCount = v != null ? v[0] : 0; break;
                        }
                        break;
                    }
                    case 2:
                    case 6: {
                        int[] v = n > 0 ? it.getItemIntArray() : null;
                        if (v == null) break;
                        if (item == 7) distLeft = v[0];
                        else if (item == 10 && v.length > 0) { distNext = v[0]; hasDistance = true; freshDistance = true; }
                        break;
                    }
                    case 3:
                    case 7: {
                        long[] v = n > 0 ? it.getItemLongArray() : null;
                        if (v == null) break;
                        if (item == 5) eta = v[0];
                        else if (item == 6) timeLeft = v[0];
                        break;
                    }
                    case 8: {
                        int[] v = it.getItemIntArray();
                        if (v == null || v.length == 0) break;
                        switch (item) {
                            case 1: state = v[0]; break;
                            case 2: maneuverState = v[0]; break;
                            case 9: distLeftUnits = v[0]; break;
                            case 12: nextUnits = v[0]; break;
                        }
                        break;
                    }
                    case 9: {
                        int[] v = n > 0 ? it.getItemIntArray() : null;
                        if (v == null) break;
                        if (item == 15) visible = v[0] != 0;
                        else if (item == 18) lanesShown = v[0] != 0;
                        else if (item == 20) supports = v[0] != 0;
                        break;
                    }
                    case 10: {
                        String[] v = n > 0 ? it.getItemStringArray() : null;
                        if (v == null) break;
                        switch (item) {
                            case 3: road = v[0]; break;
                            case 4: destination = v[0]; break;
                            case 8: distLeftStr = v[0]; break;
                            case 11: nextStr = v[0]; break;
                            case 19: sourceName = v[0]; break;
                        }
                        break;
                    }
                }
            }
            int first = list == null || list.length == 0 ? -1 : list[0];
            if (first != oldFirst && !freshDistance) hasDistance = false;
            if (state == 0 || state == 2 || state == 3 || state == 5) hasDistance = false;
        }
    }

    /** one maneuver (DiPO e/v) */
    static final class Maneuver {
        int index, type, distance, distUnits, side, junction, exit, linkedLane;
        String description, afterRoad, distStr;
        int[] angles;
        boolean hasExit, hasSide;

        Maneuver(int index, int id, Iap2NotiMsg msg) {
            if (msg == null) return;
            clear();
            read(index, id, msg);
        }

        void clear() {
            index = -1;
            description = "";
            type = 0;
            afterRoad = "";
            distance = 0;
            distStr = "";
            distUnits = 2;
            side = 0;
            junction = 0;
            angles = null;
            exit = 0;
            hasExit = false;
            hasSide = false;
            linkedLane = 0;
        }

        /** as DiPO, the exit angle resets with every update (it's only kept if this one carries it) */
        void read(int index, int id, Iap2NotiMsg msg) {
            Iap2NotiMsg.Iap2ObjGroup g = msg.getItemGroup();
            this.index = index;
            exit = 0;
            hasExit = false;
            for (int k = 0; k < g.getItemCnt(); k++) {
                Iap2NotiMsg.Iap2ObjItem it = g.getObjItem(k);
                if (it == null) continue;
                int item = it.getItemId(), n = it.getItemObjCount();
                switch (it.getItemParamType()) {
                    case 1: {
                        int[] v = n > 0 ? it.getItemIntArray() : null;
                        if (v != null && v.length == 0) v = null;
                        if (item == 10) {
                            if (v != null) {
                                n = Math.min(n, v.length);
                                angles = new int[n];
                                for (int j = 0; j < n; j++) angles[j] = v[j];
                            } else {
                                angles = null;
                            }
                        } else if (item == 11 && v != null) {
                            exit = v[0];
                            hasExit = true;
                        }
                        break;
                    }
                    case 5: {
                        int[] v = it.getItemIntArray();
                        if (item == 12 && v != null && v.length > 0) linkedLane = v[0];
                        break;
                    }
                    case 6: {
                        int[] v = n > 0 ? it.getItemIntArray() : null;
                        if (item == 5 && v != null && v.length > 0) distance = v[0];
                        break;
                    }
                    case 8: {
                        int[] v = n > 0 ? it.getItemIntArray() : null;
                        if (v == null || v.length == 0) break;
                        switch (item) {
                            case 3: type = v[0]; break;
                            case 7: distUnits = v[0]; break;
                            case 8: side = v[0]; hasSide = true; break;
                            case 9: junction = v[0]; break;
                        }
                        break;
                    }
                    case 10: {
                        String[] v = it.getItemStringArray();
                        if (v == null) break;
                        switch (item) {
                            case 2: description = v[0]; break;
                            case 4: afterRoad = v[0]; break;
                            case 6: distStr = v[0]; break;
                        }
                        break;
                    }
                }
            }
        }
    }
}
