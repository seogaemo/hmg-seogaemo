// Modified by HMG-Seogaemo: per-part requirements, runtime diagnostics and the USB CarPlay hotspot part.
package hmgapi.mods.wireless;

import android.content.ComponentName;
import android.content.Context;
import android.content.BroadcastReceiver;
import android.content.Intent;
import android.content.IntentFilter;
import android.hardware.usb.UsbDevice;
import android.net.wifi.WifiConfiguration;
import android.net.wifi.WifiManager;

import hmgapi.hook.Car;
import hmgapi.hook.Hooks;
import hmgapi.hook.LoadedApp;
import hmgapi.hook.MethodHook;
import hmgapi.hook.ModContext;
import hmgapi.hook.ModEntry;
import hmgapi.hook.Points;
import hmgapi.hook.RuntimeResult;
import java.io.File;
import java.net.NetworkInterface;

/**
 * The Wireless mod's hooks (the rest of the mod is file changes in patches.json).
 *
 * Phone Projection menu (setting "menu"): with the wireless CarPlay/AA features
 * on, HKMC_BtSettings opens the wireless projection page for Settings > Phone
 * Projection (no split screen, and only phones the stock wireless service paired).
 * Stock US/Canada opens Device Connections and stock Korea the phone projection settings
 * (split view). On those units the hook on the "open the wireless page" call does what
 * the non-wireless branch does instead (ProjectionMenu).
 * Through HMG-API's hook points (btsettings.projection_helper.*): HMG-API's map for
 * this car says what they are in this build.
 *
 * USB drives (setting "usb_drives"): the Android Auto app (HKMC_GPM) starts a wired
 * session for every USB_DEVICE_ATTACHED, so a USB drive (install stick, music) leaves
 * GalConnectionManager "Already AA Starting" with a wired start that never connects, and
 * wireless Android Auto is refused until the head unit restarts. The hook on
 * Context.startService in that app drops a wired start (startMode 1) for a device whose
 * interfaces are all mass storage (8) or hub (9). Phones and devices with no interfaces
 * start as before (hook point framework.context_impl.start_service).
 */
public final class Wireless extends ModEntry {
    static final String BTSETTINGS = "com.android.btsettings";
    static final String GPM = "com.google.android.projection.sink";
    static final String PHONE_PROJECTION = "com.daudio.app.phoneprojection";
    static final String GAL_SERVICE = "com.google.android.projection.service.GalReceiverService";
    static final int USB_CLASS_MASS_STORAGE = 8, USB_CLASS_HUB = 9;
    static final String HELPER = "btsettings.projection_helper";

    static final String NAVIGATION = "com.mnsoft.navi";
    static final String DIPO = "com.daudio.app.dipo";
    static final String IAP2 = "com.tcc.iap2server";
    /** from DiPO's CarPlay Bluetooth bridge: start / stop an iAP2 session over Bluetooth */
    static final String BT_ATTACHED = "com.ev6.cpwl.BT_ATTACHED", BT_DETACHED = "com.ev6.cpwl.BT_DETACHED";
    static final String USB_CARPLAY = "android.hardware.usb.action.CARPLAY_DEVICE_ATTACHED";
    static final String USB_DIGITAL_AUDIO = "android.hardware.usb.action.DIGITAL_AUDIO_DEVICE_ATTACHED";
    /** the iAP2 component of the Bluetooth session we asked for (0: none) */
    static volatile int btComponent;
    /** NavigationCluster's turn-by-turn calls: the car navigation's own guidance, off while a phone guides */
    static final String[] NAVI_TBT = { "update_tbt_info", "update_tbt_sub_info", "update_tbt_sub_info_b", "update_tbt_sub_info2",
        "update_tbt_sub_info2_b", "update_tbt_sub_info_2c", "update_remain_dis", "update_tp_crossroad_name",
        "update_tp_destination_name", "update_tp_turn_list", "update_tp_turn_list_new", "update_tp_lane_info", "update_lane_info",
        "update_clu_data_new_14" };

    /** In the zygote: the module's runtime record and the boot points it needs; a throw turns only this module off. */
    @Override
    public void zygoteInit(ModContext mod) {
        RuntimeResult.begin(new File("/data/nemesis/backup/hmg-seogaemo/runtime/wireless-carplay-and-aa"), "zygote", "zygote");
        if (!Points.need("boot", "boot")) {
            RuntimeResult.phase("gate", "off", "missing boot points");
            throw new IllegalStateException("missing boot points");
        }
        RuntimeResult.phase("gate", "ready", "loaded by the core hook host");
        // Still root, before apps fork: the wifi module's root-only peer file (never the passphrase in the record).
        String hotspot = UsbHotspot.snapshot();
        RuntimeResult.put("hotspot.radio", UsbHotspot.active() ? "usb" : "stock");
        RuntimeResult.put("hotspot.reason", hotspot);
    }

    @Override
    public void appLoaded(final ModContext mod, LoadedApp app) {
        String pkg = app.packageName;
        if (!NAVIGATION.equals(pkg) && !IAP2.equals(pkg) && !GPM.equals(pkg) && !BTSETTINGS.equals(pkg) && !DIPO.equals(pkg)
                && !PHONE_PROJECTION.equals(pkg)) return;
        WirelessSupport.beginRuntime(app);
        if (NAVIGATION.equals(pkg)) loadPart("navigation", "navigation", mod, app);
        if (IAP2.equals(pkg)) {
            loadPart("iap2", "iap2", mod, app);
            loadPart(UsbHotspot.active() ? "usb_hotspot" : "stock_hotspot", null, mod, app);
        }
        if (GPM.equals(pkg)) {
            loadPart("gpm_usb", "gpm_usb", mod, app);
            loadPart("gpm_tbt", "gpm", mod, app);
            loadPart(UsbHotspot.active() ? "usb_hotspot" : "stock_hotspot", null, mod, app);
        }
        if (PHONE_PROJECTION.equals(pkg)) loadPart(UsbHotspot.active() ? "usb_hotspot" : "stock_hotspot", null, mod, app);
        if (BTSETTINGS.equals(pkg)) loadPart("btsettings", "btsettings", mod, app);
        if (DIPO.equals(pkg)) loadPart("dipo", "dipo", mod, app);
    }

    /** points: the RequiredPoints part, or null for a part that hooks only framework/libcore methods */
    private void loadPart(String part, String points, ModContext mod, LoadedApp app) {
        if (points != null && !Points.need(part, points)) return;
        RuntimeResult.phase("part." + part, "initializing", "installing hooks");
        try {
            if ("navigation".equals(part)) navigation(mod, app);
            else if ("iap2".equals(part)) iap2(mod, app);
            else if ("gpm_usb".equals(part)) usbDrives(mod, app);
            else if ("gpm_tbt".equals(part)) gpmTurnByTurn(mod, app);
            else if ("btsettings".equals(part)) {
                phoneProjectionMenu(mod, app);
                projectionDelete(mod, app);
            }
            else if ("dipo".equals(part)) dipo(mod, app);
            else if ("usb_hotspot".equals(part)) usbHotspot(mod, app);
            else if ("stock_hotspot".equals(part)) stockHotspot(mod, app);
            RuntimeResult.phase("part." + part, "loaded", "gpm_tbt".equals(part) && Car.stepOfSpec() >= 999
                    ? "stock turn-by-turn active; native AA recipe inapplicable" : "initialization returned");
        } catch (Throwable t) {
            RuntimeResult.phase("part." + part, "failed", String.valueOf(t));
            mod.error(part + " initialization", t);
        }
    }

    /**
     * DiPO (CarPlay): turn-by-turn, the Bluetooth bridge and Wi-Fi audio, in the mod's DiPO part
     * (hmgapi.mods.wireless.dipo.Dipo), which links against DiPO's iAP2 and Bluetooth
     * libraries.
     */
    private void dipo(ModContext mod, LoadedApp app) throws Exception {
        WirelessSupport.appPart(app, "hmgapi.mods.wireless.dipo.Dipo").getMethod("start", ModContext.class, LoadedApp.class).invoke(null, mod, app);
    }

    /**
     * In the car navigation app, while a phone guides (Android Auto or CarPlay): its own
     * turn-by-turn calls to the cluster and HUD are skipped, so they don't fight the
     * phone's. Its speed limit, cameras, traps, warning distances and driver-assist
     * data still go through (phones carry none of that). Framework calls only: no app names.
     */
    static boolean junctionClear(Object[] args) {
        if (args == null || args.length < 2 || !(args[0] instanceof Integer) || !(args[1] instanceof Integer)) return false;
        int a = ((Integer) args[0]).intValue(), b = ((Integer) args[1]).intValue();
        return a == 65535 || a == 0 && b == 65535;
    }

    private void navigation(final ModContext mod, final LoadedApp app) {
        if (!mod.settingBoolean("tbt", true)) return;
        CpTrapOverlay.install(mod, app);
        MethodHook skip = new MethodHook() {
            @Override
            protected void beforeHookedMethod(Param p) {
                String method = p.method.getName();
                if (Car.phoneGuiding(app.context)) {
                    // stock's own junction-view clear (A 65535, or 0 with B 65535) still goes through
                    if ("updateCluDataNew_14".equals(method) && junctionClear(p.args)) return;
                    p.setResult(null);
                }
            }
        };
        for (String m : NAVI_TBT) {
            String id = "framework.navigation_cluster." + m;
            // Optional stock-guidance points (not in hookpoints.required) may be absent from the map.
            if (!Points.has(id)) { mod.log("navigation: optional " + id + " not mapped; stock calls pass"); continue; }
            mod.hook(null, id, skip);
        }
        mod.log("navigation: turn-by-turn yields to the phone in " + app.processName);
    }

    /**
     * The iAP2 server. Turn-by-turn ("tbt"): it offers RouteGuidance to the iPhone only
     * when the car's stepofspec is 999 or more (US/Canada: 105), so HMG-API sets that one
     * flag after it decides. Bluetooth bridge ("bridge"): DiPO's bridge asks for an iAP2
     * session over Bluetooth (BT_ATTACHED / BT_DETACHED, from apps holding
     * BLUETOOTH_PRIVILEGED); a USB CarPlay attach ends it first, before the server's own
     * receiver handles that attach.
     */
    private void iap2(final ModContext mod, LoadedApp app) {
        final ClassLoader cl = app.classLoader;
        if (mod.settingBoolean("tbt", true)) {
            // The stock table registers LaneGuidanceInformation under 0x5202, so a real 0x5204 is never
            // parsed. Do NOT route it to the stock parser (iap2-lane-msgid recipe): on the car (2026-11-04)
            // the first 0x5204 then crashed the iAP2 server in libIap2Acc.so
            // iAP2NativeMsg2Parcel::convertSubGroup (SIGSEGV) and route guidance stopped. Lanes need our own
            // decoder of the raw 0x5204 instead.
            mod.hook(cl, "iap2.init_info.check_supports_features", new MethodHook() {
                @Override
                protected void afterHookedMethod(Param p) {
                    try {
                        Points.field(cl, "iap2.init_info.route_guidance").setInt(null, 1);
                    } catch (Exception e) {
                        mod.error("route guidance flag", e);
                    }
                }
            });
        }
        if (!mod.settingBoolean("bridge", true)) return;
        mod.hook(cl, "iap2.service.on_create", new MethodHook() {
            @Override
            protected void afterHookedMethod(Param p) {
                final Object svc = p.thisObject;
                IntentFilter f = new IntentFilter();
                f.addAction(BT_ATTACHED);
                f.addAction(BT_DETACHED);
                ((Context) svc).registerReceiver(new BroadcastReceiver() {
                    @Override
                    public void onReceive(Context c, Intent i) {
                        try {
                            if (BT_ATTACHED.equals(i.getAction())) btAttach(mod, cl, svc, i);
                            else stopBt(mod, cl, svc, "detach");
                        } catch (Throwable t) {
                            mod.error("bridge " + i.getAction(), t);
                        }
                    }
                }, f, "android.permission.BLUETOOTH_PRIVILEGED", null);
                mod.log("bridge: iAP2 listens for DiPO's Bluetooth sessions");
            }
        });
        mod.hook(cl, "iap2.service_receiver.on_receive", new MethodHook() {
            @Override
            protected void beforeHookedMethod(Param p) {
                Intent i = (Intent) p.args[1];
                String a = i == null ? null : i.getAction();
                if (!USB_CARPLAY.equals(a) && !USB_DIGITAL_AUDIO.equals(a)) return;
                try {
                    stopBt(mod, cl, Points.get(cl, "iap2.service_receiver.service", p.thisObject), "usb attach");
                } catch (Throwable t) {
                    mod.error("bridge: usb attach", t);
                }
            }
        });
    }

    static void btAttach(ModContext mod, ClassLoader cl, Object svc, Intent i) {
        int comp = i.getIntExtra("component", 4);
        if (comp < 3 || comp > 5) comp = 4;
        String serial = i.getStringExtra("serial");
        if (btComponent == 0 && Boolean.TRUE.equals(Points.call(cl, "iap2.service.is_connected", null))) {
            mod.log("bridge: attach ignored, another iAP2 session is up (component "
                    + Points.call(cl, "iap2.service.get_component", null) + ")");
            return;
        }
        stopBt(mod, cl, svc, "re-attach");
        btComponent = comp;
        Points.call(cl, "iap2.service.set_device_serial", svc, serial);
        Points.call(cl, "iap2.service.receive_connect", svc, comp);
        mod.log("bridge: Bluetooth iAP2 session requested, component " + comp + " serial " + serial);
    }

    static void stopBt(ModContext mod, ClassLoader cl, Object svc, String why) {
        int c = btComponent;
        if (c == 0) return;
        btComponent = 0;
        Points.call(cl, "iap2.service.set_device_serial", svc, (Object) null);
        Points.call(cl, "iap2.service.receive_disconnect", svc, c);
        mod.log("bridge: Bluetooth iAP2 session stopped, component " + c + " (" + why + ")");
    }

    /**
     * Android Auto turn-by-turn (GPM). GPM's own turn-by-turn manager only exists when
     * the car's stepofspec is 999 or more (US/Canada: 105), and it claims the cluster in a
     * way these cars don't give back. HMG-API leaves GPM's manager off and runs its own
     * (AaTurns) from the AA library's callbacks, sending through HMG-API's Cluster API.
     * GPM tells the phone its cluster takes pictures (IMAGE); HMG-API says ENUM, so the
     * phone sends turn data the cluster can show. One AaTurns per connection (GalReceiver),
     * all on one thread.
     */
    private void gpmTurnByTurn(final ModContext mod, final LoadedApp app) {
        final ClassLoader cl = app.classLoader;
        if (Car.stepOfSpec() >= 999) {
            RuntimeResult.put("native.libautoreceiver_infobank.so.applicability", "stock");
            mod.log("Android Auto: stepofspec is 999 or more, GPM's own turn-by-turn runs (HMG-API's stays off)");
            return;
        }
        // the AA library: protocol 1.6 and the turn-by-turn extras packed into its callbacks, in memory (file stays stock)
        WirelessSupport.nativePatch(mod, "libautoreceiver_infobank.so");
        mod.hook(cl, "gpm.navigation_status.init", new MethodHook() {
            @Override
            protected void beforeHookedMethod(Param p) {
                if (p.args[3] == Points.get(cl, "gpm.cluster_type.image", null)) p.args[3] = Points.get(cl, "gpm.cluster_type.enum", null);
            }
        });
        final java.util.Map<Object, AaTurns> turns = new java.util.WeakHashMap<Object, AaTurns>();
        final android.os.HandlerThread thread = new android.os.HandlerThread("hmgapi-aa-tbt");
        thread.start();
        final android.os.Handler handler = new android.os.Handler(thread.getLooper());
        abstract class OnTurns extends MethodHook {
            abstract void run(AaTurns t, Object[] a);

            /** receiver: the GalReceiver; create: make its AaTurns if there's none yet */
            void post(final Object receiver, final boolean create, final Object[] args) {
                handler.post(new Runnable() {
                    @Override
                    public void run() {
                        try {
                            AaTurns t;
                            synchronized (turns) {
                                t = turns.get(receiver);
                                if (t == null && create) {
                                    hmgapi.hook.Cluster c = hmgapi.hook.Cluster.of(app.context);
                                    if (c == null) { mod.error("Android Auto cluster unavailable", null); return; }
                                    turns.put(receiver, t = new AaTurns(app.context, c, handler));
                                    mod.log("Android Auto: turn-by-turn to the cluster for this connection");
                                }
                            }
                            if (t != null) OnTurns.this.run(t, args);
                        } catch (Throwable x) {
                            mod.error("Android Auto turn-by-turn", x);
                        }
                    }
                });
            }

            @Override
            protected void afterHookedMethod(Param p) {
                post(Points.get(cl, "gpm.navigation_status.receiver", p.thisObject), true, p.args.clone());
            }
        }
        mod.hook(cl, "gpm.navigation_status.next_turn", new OnTurns() {
            @Override
            void run(AaTurns t, Object[] a) {
                t.nextTurn((String) a[0], (Integer) a[1], (Integer) a[2], (Integer) a[4], (Integer) a[5]);
            }
        });
        mod.hook(cl, "gpm.navigation_status.next_turn_distance", new OnTurns() {
            @Override
            void run(AaTurns t, Object[] a) {
                t.nextTurnDistance((Integer) a[0], (Integer) a[1], (Integer) a[2], (Integer) a[3]);
            }
        });
        mod.hook(cl, "gpm.navigation_status.status", new OnTurns() {
            @Override
            void run(AaTurns t, Object[] a) {
                t.status((Integer) a[0]);
            }
        });
        mod.hook(cl, "gpm.receiver.send_navigation_focus", new OnTurns() {
            @Override
            void run(AaTurns t, Object[] a) {
                if (a[0].equals(Points.get(cl, "gpm.receiver.focus_native", null))) t.stop();
            }

            @Override
            protected void afterHookedMethod(Param p) {
                post(p.thisObject, false, p.args.clone());
            }
        });
        mod.hook(cl, "gpm.receiver.destroy", new OnTurns() {
            @Override
            void run(AaTurns t, Object[] a) {
                t.end();
                synchronized (turns) {
                    turns.values().remove(t);
                }
            }

            @Override
            protected void beforeHookedMethod(Param p) {
                post(p.thisObject, false, new Object[0]);
            }

            @Override
            protected void afterHookedMethod(Param p) {}
        });
    }

    /**
     * The USB CarPlay hotspot (part "usb_hotspot"): loaded only when the zygote snapshot found radio=usb
     * from the wifi module, which runs hostapd on the adapter. Framework and libcore methods only, so no
     * map points. The iAP2 server and GPM read the hotspot credentials from
     * WifiManager.getWifiApConfiguration(): they get the published SSID and passphrase as WPA2-PSK.
     * GPM's host locator takes the interface named "wlan0" (host IP, BSSID from its MAC, AA port 40515):
     * in GPM only, the USB interface is called "wlan0" and a real wlan0 another name. GPM's start request also
     * wants isWifiApEnabled() and getWifiApMode() == 2 (else it answers the phone STATUS_WIFI_DISABLED), and so does
     * PhoneProjection's wireless service (a/f.getWiFiApMode: mode 2 "CONNECTIVITY" before it starts a wireless
     * connection; else APMode.UNKNOWN and nothing starts): in those two apps both report the adapter's hotspot while it
     * is serving (UsbHotspot.apUp). PhoneProjection also turns the stock hotspot off and on around a connection
     * (a/f.l and a/f.k, setWifiApEnabledForConnectivity): there it is a no-op while the adapter's hotspot serves.
     */
    private void usbHotspot(final ModContext mod, LoadedApp app) {
        final String proc = app.processName;
        Hooks.findAndHookMethod(WifiManager.class, "getWifiApConfiguration", new MethodHook() {
            @Override
            protected void afterHookedMethod(Param p) {
                try {
                    p.setResult(UsbHotspot.apConfiguration());
                } catch (Throwable t) {
                    mod.error("USB hotspot configuration", t);
                }
            }
        });
        if (GPM.equals(app.packageName) || PHONE_PROJECTION.equals(app.packageName)) {
            Hooks.findAndHookMethod(WifiManager.class, "isWifiApEnabled", new MethodHook() {
                @Override
                protected void afterHookedMethod(Param p) {
                    boolean real = Boolean.TRUE.equals(p.getResult());
                    if (UsbHotspot.gpmApEnabled(real) == real) return;
                    noteApOverride(mod, proc, "isWifiApEnabled");
                    p.setResult(Boolean.TRUE);
                }
            });
            Hooks.findAndHookMethod(WifiManager.class, "getWifiApMode", new MethodHook() {
                @Override
                protected void afterHookedMethod(Param p) {
                    Object real = p.getResult();
                    int mode = UsbHotspot.gpmApMode(real instanceof Integer ? (Integer) real : 0);
                    if (real instanceof Integer && (Integer) real == mode) return;
                    noteApOverride(mod, proc, "getWifiApMode");
                    p.setResult(Integer.valueOf(mode));
                }
            });
        }
        if (PHONE_PROJECTION.equals(app.packageName)) {
            try {
                Hooks.findAndHookMethod(WifiManager.class, "setWifiApEnabledForConnectivity", WifiConfiguration.class, boolean.class,
                    new MethodHook() {
                        @Override
                        protected void beforeHookedMethod(Param p) {
                            if (!UsbHotspot.apUp()) return;
                            mod.log("stock hotspot " + p.args[1] + " skipped, the USB hotspot serves");
                            p.setResult(Boolean.TRUE);
                        }
                    });
            } catch (Throwable t) {
                mod.error("USB hotspot stock switch", t);
            }
        }
        if (GPM.equals(app.packageName)) {
            try {
                advertiseHotspotBand(mod, app.classLoader);
            } catch (Throwable t) {
                mod.error("USB hotspot band", t);
            }
            MethodHook rename = new MethodHook() {
                @Override
                protected void afterHookedMethod(Param p) {
                    Object name = p.getResult();
                    if (name instanceof String) p.setResult(UsbHotspot.gpmName((String) name));
                }
            };
            Hooks.findAndHookMethod(NetworkInterface.class, "getName", rename);
            Hooks.findAndHookMethod(NetworkInterface.class, "getDisplayName", rename);
        }
        mod.log("USB hotspot " + UsbHotspot.iface() + " for wireless projection in " + app.processName);
    }

    /**
     * The stock hotspot (part "stock_hotspot", no map points; contract "Peer info"; StockHotspot) on units whose
     * setWifiApEnabledForConnectivity brings up the normal hotspot or nothing. The iAP2 server and GPM give the phone the
     * normal hotspot's name and passphrase while the normal one serves or none does; GPM and PhoneProjection see mode 2
     * while the normal one serves (their start checks want it); after PhoneProjection's own connectivity request the
     * normal hotspot is started when nothing came up. A unit whose connectivity hotspot comes up is left stock.
     */
    private void stockHotspot(final ModContext mod, LoadedApp app) {
        final String proc = app.processName;
        if (IAP2.equals(app.packageName) || GPM.equals(app.packageName)) {
            Hooks.findAndHookMethod(WifiManager.class, "getWifiApConfiguration", new MethodHook() {
                @Override
                protected void afterHookedMethod(Param p) {
                    try {
                        Object c = p.getResult();
                        if (!(c instanceof WifiConfiguration)) return;
                        int state = StockHotspot.state(p.thisObject), mode = StockHotspot.mode(p.thisObject);
                        if (StockHotspot.shareNormal(state, mode) && StockHotspot.useNormal((WifiConfiguration) c))
                            noteStock(mod, proc, "getWifiApConfiguration", "the normal hotspot's name and passphrase (" + StockHotspot.describe(state, mode) + ")");
                    } catch (Throwable t) {
                        mod.error("stock hotspot configuration", t);
                    }
                }
            });
        }
        if (GPM.equals(app.packageName) || PHONE_PROJECTION.equals(app.packageName)) {
            Hooks.findAndHookMethod(WifiManager.class, "getWifiApMode", new MethodHook() {
                @Override
                protected void afterHookedMethod(Param p) {
                    Object real = p.getResult();
                    if (StockHotspot.reading() || !(real instanceof Integer)) return;
                    int state = StockHotspot.state(p.thisObject);
                    int seen = StockHotspot.apMode(state, (Integer) real);
                    if (seen == (Integer) real) return;
                    noteStock(mod, proc, "getWifiApMode", "2 for the normal hotspot (" + StockHotspot.describe(state, (Integer) real) + ")");
                    p.setResult(Integer.valueOf(seen));
                }
            });
        }
        if (PHONE_PROJECTION.equals(app.packageName)) {
            Hooks.findAndHookMethod(WifiManager.class, "setWifiApEnabledForConnectivity", WifiConfiguration.class, boolean.class,
                new MethodHook() {
                    @Override
                    protected void afterHookedMethod(Param p) {
                        if (!Boolean.TRUE.equals(p.args[1])) return;
                        StockHotspot.startLater(p.thisObject, new StockHotspot.Log() {
                            @Override
                            public void log(String message) {
                                mod.log(message);
                            }
                        });
                    }
                });
        }
        mod.log("stock hotspot checks for wireless projection in " + proc);
    }

    private static final java.util.Set<String> STOCK_LOGGED = new java.util.HashSet<String>();

    /** Evidence for a problem report: the first time each app and call is answered for the normal hotspot. */
    private static void noteStock(ModContext mod, String app, String call, String what) {
        synchronized (STOCK_LOGGED) {
            if (!STOCK_LOGGED.add(app + " " + call)) return;
        }
        mod.log(app + " " + call + " answered with " + what);
    }

    /**
     * GPM's WifiVersionRequest builder: stock sets CHANNELS_5GHZ_ONLY and adds 5745 and 5180 (MHz); the hotspot's
     * band and frequency go there instead while its interface is up (UsbHotspot.gpmChannelType / gpmFrequency).
     * The same list in WifiData.setSupportedChannels, which CarWifiStub reads for the CarWifiCredentials.
     * Classes by name in GPM's loader: they are not hookpoints, so there is no map point.
     */
    @SuppressWarnings({"unchecked", "rawtypes"})
    private static void advertiseHotspotBand(final ModContext mod, ClassLoader cl) {
        String builder = "com.google.android.projection.proto.WifiDiscoveryProtos$WifiVersionRequest$Builder";
        Hooks.findAndHookMethod(builder, cl, "setSupportedWifiChannelType",
            "com.google.android.projection.proto.WifiDiscoveryProtos$WifiChannelType", new MethodHook() {
                @Override
                protected void beforeHookedMethod(Param p) {
                    String name = UsbHotspot.gpmChannelType();
                    if (name == null || p.args[0] == null) return;
                    p.args[0] = Enum.valueOf(((Enum) p.args[0]).getDeclaringClass(), name);
                    mod.log("GPM version request: " + name + " " + UsbHotspot.frequency() + " MHz");
                }
            });
        Hooks.findAndHookMethod("com.google.android.projection.sink.wireless.WifiData", cl, "setSupportedChannels",
            int[].class, new MethodHook() {
                @Override
                protected void beforeHookedMethod(Param p) {
                    int[] stock = (int[]) p.args[0];
                    int[] mine = UsbHotspot.gpmChannels(stock);
                    if (mine != stock) p.args[0] = mine;
                }
            });
        Hooks.findAndHookMethod(builder, cl, "addSupportedWifiChannels", int.class, new MethodHook() {
            @Override
            protected void beforeHookedMethod(Param p) {
                int stock = (Integer) p.args[0];
                int mhz = UsbHotspot.gpmFrequency(stock);
                if (mhz == stock) return;
                if (mhz < 0) p.setResult(p.thisObject);
                else p.args[0] = Integer.valueOf(mhz);
            }
        });
    }

    private static final java.util.Set<String> AP_OVERRIDE_LOGGED = new java.util.HashSet<String>();

    /** Evidence for a problem report: the first time each app is told the adapter's hotspot is the enabled one. */
    private static void noteApOverride(ModContext mod, String app, String call) {
        synchronized (AP_OVERRIDE_LOGGED) {
            if (!AP_OVERRIDE_LOGGED.add(app)) return;
        }
        mod.log(app + " " + call + " answered for the USB hotspot " + UsbHotspot.iface());
    }

    private void usbDrives(final ModContext mod, LoadedApp app) {
        mod.hook(null, "framework.context_impl.start_service", new MethodHook() {
            @Override
            protected void beforeHookedMethod(Param p) {
                Intent i = (Intent) p.args[0];
                ComponentName c = i == null ? null : i.getComponent();
                if (c == null || !GAL_SERVICE.equals(c.getClassName()) || i.getIntExtra("startMode", -1) != 1) return;
                UsbDevice d = i.getParcelableExtra("device");
                if (!notPhone(d)) return;
                p.setResult(null);
                mod.log("USB drive or hub (" + d.getDeviceName() + "), not starting wired Android Auto");
            }
        });
        mod.log("USB drive hook in " + app.processName);
    }

    /** true when the device has interfaces and every one is mass storage or a hub */
    static boolean notPhone(UsbDevice d) {
        if (d == null || d.getInterfaceCount() == 0) return false;
        for (int k = 0; k < d.getInterfaceCount(); k++) {
            int cls = d.getInterface(k).getInterfaceClass();
            if (cls != USB_CLASS_MASS_STORAGE && cls != USB_CLASS_HUB) return false;
        }
        return true;
    }

    /**
     * BtSettings: deleting the connected wireless CarPlay phone waits for its end (ProjectionDelete): the stock disconnect
     * goes first, the Phone Projection row is deleted after the matching end, or by the 15 s fallback. Hooked only when the
     * three optional points are mapped and the kill switch (persist.hmg_seogaemo.owner) is not "0"; otherwise stock runs.
     */
    private void projectionDelete(final ModContext mod, LoadedApp app) {
        if (!ProjectionDeleteEnv.killSwitchOn()) {
            mod.log("delete: off (persist.hmg_seogaemo.owner=0)");
            return;
        }
        String missing = Points.missing("btsettings.pp_bt", "btsettings.pp_bt.request_delete", "btsettings.pp_bt.send_disconnect");
        if (missing.length() != 0) {
            mod.log("delete: points missing, off (" + missing + ")");
            return;
        }
        try {
            ProjectionDeleteEnv.bind(mod, app);
            mod.hook(app.classLoader, "btsettings.pp_bt.request_delete", new MethodHook() {
                @Override
                protected void beforeHookedMethod(Param p) {
                    if (ProjectionDeleteEnv.hold(p.thisObject, (String) p.args[0])) p.setResult(Boolean.FALSE);
                }
            });
            mod.log("delete: connected CarPlay deletion waits for its end");
        } catch (Throwable t) {
            mod.error("delete hook", t);
        }
    }

    private void phoneProjectionMenu(final ModContext mod, LoadedApp app) {
        final ClassLoader cl = app.classLoader;
        mod.hook(cl, HELPER + ".open_wireless_page", new MethodHook() {
            @Override
            protected void beforeHookedMethod(Param p) {
                int region = Car.region();
                boolean dc = (region == ProjectionMenu.REGION_US || region == ProjectionMenu.REGION_CANADA)
                        && Boolean.TRUE.equals(Points.call(cl, HELPER + ".device_connections_available", null));
                int target = ProjectionMenu.target(region, dc);
                if (target == ProjectionMenu.STOCK) return;   // other regions: stock choice
                Context c = (Context) p.args[0];
                if (target == ProjectionMenu.DEVICE_CONNECTIONS) {
                    Points.call(cl, HELPER + ".open_device_connections", null, c, 1);
                } else {
                    Points.call(cl, HELPER + ".open_other_page", null, c);
                }
                p.setResult(null);
                mod.log("Phone Projection: " + (region == ProjectionMenu.REGION_KR
                        ? "stock Korean settings screen" : "Device Connections (US/Canada)")
                        + " (region " + region + "), not the wireless page");
            }
        });
        mod.log("Phone Projection menu hook in " + app.processName);
    }
}
