  "mksh": {
    "version": "R43 2013/02/19",
    "android_build": 431,
    "flags": [
      "MKSH_ASSUME_UTF8",
      "MKSH_CONSERVATIVE_FDS",
      "MKSH_NOPWNAM",
      "MKSH_BUILDSH",
      "HAVE_SELECT=1",
      "HAVE_MKNOD=0"
    ],
    "disabled": [
      "MKSH_PRINTF_BUILTIN"
    ],
    "features": [
      "POSIX command lists and pipelines",
      "background jobs, wait, kill",
      "case, for, while, until, functions",
      "read with IFS",
      "test and [ and [[",
      "arithmetic expansion",
      "typeset and local alias",
      "ANSI C quoting",
      "parameter length, trim, default and pattern substitution",
      "here-documents",
      "command substitution"
    ],
    "unsupported": [
      "Bash process substitution",
      "Bash regex =~",
      "Bash case conversion and @Q expansion",
      "Bash associative arrays",
      "Bash readarray/mapfile",
      "Bash &> redirection",
      "set -o pipefail (absent in R43)"
    ],
    "echo": "Invocation as sh selects POSIX echo behavior: initial -n only, otherwise literal; use print -r -- for unambiguous text.",
    "builtins_source": "external/mksh/src/funcs.c:mkshbuiltins; src/main.c:aliases; src/sh_flags.h",
    "set_options": [
      "errexit",
      "nounset",
      "xtrace",
      "noglob",
      "posix",
      "monitor",
      "noclobber"
    ]
  },
